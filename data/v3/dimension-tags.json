  "tagging_rules": {
    "rule_1": {
      "name": "CAP-SKILL → dimension_tags 正向打标",
      "desc": "question_map 每条 skill_standard 编号 → 自动匹配 dimension-tags 里的 tier_in_dim → 归入对应维度的 primary 或 secondary",
      "example": "CAP-SKILL-006（获客触达）→ tier_in_dim=ACQUISITION → 归入 ACQUISITION 维度 primary 能力"
    },
    "rule_2": {
      "name": "speech_variants → persona 打标",
      "desc": "speech_variants 里的 customer_type → 自动匹配 sales-sop.json personas（rational/emotional/anxious）",
      "example": "customer_type='理性客户·看数据看对比' → persona.id=rational → 匹配 TRUST-01 persona_variants.rational"
    },
    "rule_3": {
      "name": "kb_query → 五层知识打标",
      "desc": "question_map kb_query 关键词 → 匹配本地知识库五层条目（板块/商圈/小区/楼栋/生活）",
      "example": "kb_query='大西洋新城供暖' → 匹配楼栋层条目 → PRO-04 标签"
    },
    "rule_4": {
      "name": "stage → trust_action 映射",
      "desc": "prepare/market/invite → TRUST-01 破冰 + TRUST-02 证明；negotiate → TRUST-03 共情；transaction/closing → TRUST-04 引导",
      "example": "stage=negotiate 默认进入 TRUST-03 共情接住阶段"
    },
    "rule_5": {
      "name": "红线自动拦截",
      "desc": "所有输出先过 sales-sop.json redlines_global 6 条红线检查，任何一条命中则不输出",
      "example": "AI 输出'您应该选大西洋新城' → RED-01 命中 → 拦截"
    }
  },
