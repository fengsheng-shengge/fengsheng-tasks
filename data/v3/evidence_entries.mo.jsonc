    {
      // 原始 entries.json 里 dataRef 字段经常跟 legalRef 重复（脏数据）
      // adapter.isLawText() 会识别并跳过；这里演示去重后的最终形态
      // 脚本灌完后 adapter.dedupeEvidenceByType() 再扫一遍
      "entry_id": "RISK-DEDUP-001",
      "entry_type": "RISK",
      "evidence": [
        // 原始 legalRef: "民法典第五百七十七条"  → type=law, authority=A
        {
