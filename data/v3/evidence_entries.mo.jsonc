  "_validation": {
    "expected_keys_per_evidence": [
      "type", "title", "source_name", "url", "authority_level", "verified_date", "as_of"
    ],
    "required_keys_per_entry": [
      "entry_id", "entry_type", "evidence", "b_level_tag", "l3_blocked", "caveat"
    ],
    "enum_values": {
      "entry_type": ["LAW", "POL", "PROC", "RISK", "CASE", "DATA", "TERM", "STD", "ABIL", "KNOWLEDGE"],
      "evidence.type": ["law", "case", "data", "policy", "experience"],
      "authority_level": ["A", "B", "C"]
    },
    "url_rule": "空字符串 '' = 待核验；必须写 url 字段（不能缺省）",
    "adapter_entry": "lib/evidence/data-adapter.js → adaptEntry(rawEntry)"
  }
