@role_required("teacher")
def teacher_mentorship():
    db = get_db()
    pairs = db.execute("""
        SELECT m.*, s.name AS stu_name, s.school, s.student_status
        FROM mentorship m LEFT JOIN campus_student s ON m.sid=s.sid
        ORDER BY m.id DESC""").fetchall()
    # 已结业未结对的学员（可结对候选）
    unpaired = db.execute("""
        SELECT sid, name, school FROM campus_student
        WHERE student_status IN ('已结业','在训') AND sid NOT IN (SELECT sid FROM mentorship WHERE status='active')
        ORDER BY sid""").fetchall()
    return render_template("teacher_mentorship.html",
                           user={"display_name":session.get("display_name"),"role":"teacher"},
                           active="mentorship", pairs=pairs, unpaired=unpaired)

