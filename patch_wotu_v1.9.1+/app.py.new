# ─── 学员：考 · 结训大考 ───
@app.route("/exam")
@login_required
@role_required("student")
def student_exam():
    sid = sid_for_user(session["user_id"]) or session["user_id"]
    db = get_db()
    cfg = db.execute("SELECT * FROM exam_config WHERE id=1").fetchone()
    exam_open = bool(cfg and cfg["is_open"])
    paper = cfg["active_paper"] if cfg else None

    # 模块1：理论考试
    theory = None
    if paper:
        groups = CHOICE_DOCUMENTS.get(paper, [])
        theory = db.execute(
            f"SELECT score FROM campus_quiz_result WHERE sid=? AND quiz_group IN ({','.join('?'*len(groups))}) ORDER BY score DESC LIMIT 1",
            (sid, *groups)).fetchone()

    # 模块2：综合实操（租赁业务全流程，day=8）
    practical = db.execute(
        "SELECT * FROM practice_submission WHERE sid=? AND day=8 ORDER BY id DESC LIMIT 1",
        (sid,)).fetchone()
    practical_review = db.execute(
        "SELECT * FROM practice_review WHERE sid=? AND day=8 ORDER BY id DESC LIMIT 1",
        (sid,)).fetchone()

    # 模块3：情景应变
    scenario_done = db.execute(
        "SELECT COUNT(*) c FROM scenario_attempts WHERE sid=?", (sid,)).fetchone()["c"] if db.execute(
            "SELECT name FROM sqlite_master WHERE type='table' AND name='scenario_attempts'").fetchone() else 0
    # 简化：看session里有没有抽题记录
    scenario_state = session.get("current_scenario")

    user = {"display_name": session.get("display_name"), "role": "student"}
    return render_template("student_exam.html", cfg=cfg, exam_open=exam_open, paper=paper,
                           theory=theory, practical=practical, practical_review=practical_review,
                           scenario_done=scenario_done, scenario_state=scenario_state,
                           user=user, active="exam")


@app.route("/exam/practical", methods=["POST"])
@login_required
@role_required("student")
def exam_practical_submit():
    sid = sid_for_user(session["user_id"]) or session["user_id"]
    content = request.form.get("content", "").strip()
    db = get_db()
    existing = db.execute("SELECT id, attachment_path FROM practice_submission WHERE sid=? AND day=8", (sid,)).fetchone()
    now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    # 处理文件
    attachment_path = existing["attachment_path"] if existing else None
    f = request.files.get("attachment")
    if f and f.filename:
        ext = os.path.splitext(f.filename)[1].lower()
        allowed = {".pdf",".doc",".docx",".ppt",".pptx",".jpg",".jpeg",".png",".mp4",".mov",".zip"}
        if ext in allowed:
            fname = f"exam_{sid}_{datetime.now().strftime('%Y%m%d%H%M%S')}{ext}"
            f.save(os.path.join(UPLOAD_DIR, fname))
            attachment_path = fname
    if not content and not attachment_path:
        flash("请填写方案说明或上传交付物", "error")
        return redirect(url_for("student_exam"))
    if existing:
        db.execute("UPDATE practice_submission SET content=?, attachment_path=?, created_at=? WHERE id=?",
                   (content, attachment_path, now, existing["id"]))
    else:
        db.execute("INSERT INTO practice_submission (sid, day, deliverable_index, content, attachment_path, created_at) VALUES (?,?,?,?,?,?)",
                   (sid, 8, 0, content, attachment_path, now))
    db.commit()
    flash("综合实操方案已提交，等待助教/专家评审", "success")
    return redirect(url_for("student_exam"))


