def pm_showcase_export():
    """导出标杆案例集：说明页 + 作品附件，打包 zip"""
    db = get_db()
    rows = db.execute("""
        SELECT sw.*, s.name AS stu_name FROM showcase_work sw
        LEFT JOIN campus_student s ON sw.sid=s.sid ORDER BY sw.id""").fetchall()
    buf = io.BytesIO()
    with zipfile.ZipFile(buf, "w", zipfile.ZIP_DEFLATED) as zf:
        # 说明页
        lines = ["沃土计划 · 标杆案例集", "导出时间: " + datetime.now().strftime("%Y-%m-%d %H:%M:%S"), "", ""]
        for w in rows:
            lines.append(f"【{w['stu_name'] or w['sid']} · {w['title']}】")
            lines.append(f"  学员: {w['sid']}  推荐人: {w['recommend_by'] or '—'}")
            if w["description"]:
                lines.append(f"  推荐理由: {w['description']}")
            lines.append(f"  作品文件: {w['attachment_path'] or '—'}")
            lines.append("")
        zf.writestr("标杆案例集说明.txt", "\n".join(lines).encode("utf-8"))
        # 附件
        added = set()
        for w in rows:
            p = w["attachment_path"]
            if p and p not in added and os.path.exists(os.path.join(UPLOAD_DIR, p)):
                zf.write(os.path.join(UPLOAD_DIR, p), f"works/{w['sid']}_{p}")
                added.add(p)
    resp = Response(buf.getvalue(), mimetype="application/zip")
    resp.headers["Content-Disposition"] = "attachment; filename=showcase_works.zip"
    return resp


@app.route("/pm/students/import", methods=["POST"])
@login_required
@role_required("pm")
def pm_students_import():
    f = request.files.get("file")
    if not f or not f.filename:
        flash("请选择 CSV 文件", "danger")
        return redirect(url_for("pm_students"))
    content = f.read().decode("utf-8-sig", errors="replace")
    ok, skip, errors = import_students_csv(get_db(), content, "class01")
    msg = f"导入完成：新增 {ok} 人，跳过重复 {skip} 人" + (f"，{len(errors)} 行有误" if errors else "")
    flash(msg, "success" if ok else "warn")
    if errors:
        flash("；".join(errors[:5]), "danger")
    return redirect(url_for("pm_students"))


