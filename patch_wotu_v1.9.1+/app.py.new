    resp.headers["Content-Disposition"] = "attachment; filename=onboard_tracking.csv"
    return resp


# ═══ PM：优秀学员档案 / 校友会 / 标杆案例集 ═══
def _auto_register_alumni(db):
    """已结业学员自动收录进校友会（幂等）"""
    now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    rows = db.execute("""
        SELECT s.sid, s.name, c.grade, c.cert_no FROM campus_student s
        JOIN campus_cert_result c ON s.sid=c.sid AND c.is_valid=1
        WHERE c.is_pass=1""").fetchall()
    n = 0
    for r in rows:
        exists = db.execute("SELECT sid FROM alumni WHERE sid=?", (r["sid"],)).fetchone()
        if not exists:
            db.execute("""INSERT INTO alumni (sid, name, grade, grad_date, alumni_level, status, created_at)
                          VALUES (?,?,?,?,?,?,?)""",
                (r["sid"], r["name"], r["grade"], now[:10], "普通校友", "active", now))
            n += 1
    db.commit()
    return n


@app.route("/pm/alumni")
@login_required
@role_required("pm")
def pm_alumni():
    db = get_db()
    _auto_register_alumni(db)
    rows = db.execute("SELECT * FROM alumni ORDER BY id DESC").fetchall()
    perf_map = {}
    for a in rows:
        p = db.execute("SELECT * FROM alumni_performance WHERE sid=? ORDER BY record_month DESC LIMIT 1",
                       (a["sid"],)).fetchone()
        perf_map[a["sid"]] = p
    stats = {"total": len(rows),
             "on_job": sum(1 for r in rows if r["company"]),
             "active": sum(1 for r in rows if r["status"] == "active")}
    return render_template("pm_alumni.html", alumni=rows, perf_map=perf_map, stats=stats,
                           user={"display_name":session.get("display_name"),"role":"pm"},
                           active="pm_alumni")

