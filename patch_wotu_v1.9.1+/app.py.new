# ─── PM：系统设置 ───
@app.route("/pm/settings", methods=["GET", "POST"])
@login_required
@role_required("pm")
def pm_settings():
    db = get_db()
    if request.method == "POST":
        for k in ["pass_score", "cert_prefix", "icp_no", "gongan_no", "demo_mode",
                  "points_submit", "points_drill", "points_review85", "points_review60", "points_attendance"]:
            # 只更新本次提交的字段，避免缺字段时把已有配置清空
            if k in request.form:
                db.execute("INSERT OR REPLACE INTO system_config VALUES (?,?)", (k, request.form.get(k, "")))
        db.commit()
        _audit(db, "系统设置", "更新系统配置（含积分规则）")
        flash("设置已保存", "success")
        return redirect(url_for("pm_settings"))
    config = dict(db.execute("SELECT key, value FROM system_config").fetchall())
    # 待清空业务数据统计（供初始化区块展示）
    _tables_info = []
    for t in _RESET_TABLES:
        try:
            n = db.execute(f"SELECT COUNT(*) FROM {t}").fetchone()[0]
            if n > 0:
                _tables_info.append((t, n))
        except Exception:
            pass
    return render_template("pm_settings.html", user={"display_name":session.get("display_name"),"role":"pm"}, active="pm_settings", config=config, tables=_tables_info)


# ─── PM：系统初始化（清空业务数据，保留题库/账号/配置）───
# 业务数据表：清空；保留表：题库/账号/配置/任务定义/评分锚点/情景题库
_RESET_TABLES = [
    "practice_submission", "practice_review",
    "campus_quiz_result", "campus_quiz_result_old", "quiz_choice_detail",
    "campus_cert_result", "expert_review", "soft_review_score",
    "phase_evidence", "campus_appeal", "campus_risk_action",
    "campus_audit_log", "campus_student", "campus_class_stat",
    "class_schedule", "announcement", "course_material",
    "campus_virtual_material", "instructor",
    "campus_batch", "campus_class",
]

@app.route("/pm/init-system", methods=["GET", "POST"])
@login_required
@role_required("pm")
def pm_init_system():
    db = get_db()
    if request.method == "POST":
        confirm = request.form.get("confirm", "").strip()
        if confirm != "清空并初始化":
            flash("确认词输入错误，未执行任何操作", "error")
            return redirect(url_for("pm_settings"))
        try:
            for t in _RESET_TABLES:
                db.execute(f"DELETE FROM {t}")
            # 重置自增计数
            try:
                for r in db.execute("SELECT name FROM sqlite_master WHERE type='table' AND name IN ('practice_submission','practice_review','announcement','class_schedule','instructor')").fetchall():
                    db.execute(f"DELETE FROM sqlite_sequence WHERE name=?", (r["name"],))
            except Exception:
                pass
            db.commit()
            flash(f"系统已初始化：已清空 {len(_RESET_TABLES)} 类业务数据，题库/账号/系统配置已保留", "success")
        except Exception as e:
            db.rollback()
            flash(f"初始化失败：{e}", "error")
        return redirect(url_for("pm_settings"))
    # GET 直接回设置页（初始化表单集成在设置页）
    return redirect(url_for("pm_settings"))


