#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
沃土计划 · 校园实训考核系统（网页端）
Flask + SQLite · 学员工作台 + PM 交付包导出
数据库只读，不改动 wotu_full.db
"""
import os
import io
import csv
import math
import zipfile
import hashlib
import sqlite3
from datetime import datetime, timedelta
from functools import wraps

from flask import (Flask, g, render_template, request, redirect,
                   url_for, session, flash, Response, jsonify, send_from_directory)

BASE_DIR = os.path.dirname(os.path.abspath(__file__))
DB_PATH = os.path.join(BASE_DIR, "wotu_full.db")
UPLOAD_DIR = os.path.join(BASE_DIR, "uploads")
os.makedirs(UPLOAD_DIR, exist_ok=True)
app = Flask(__name__)
app.config["MAX_CONTENT_LENGTH"] = 100 * 1024 * 1024  # 100MB
# 密钥：环境变量优先，否则自动生成并写入文件（重启后保持一致）
_key_file = os.path.join(BASE_DIR, ".secret_key")
if os.environ.get("WOTU_SECRET_KEY"):
    app.secret_key = os.environ["WOTU_SECRET_KEY"]
elif os.path.exists(_key_file):
    with open(_key_file, "r") as f:
        app.secret_key = f.read().strip()
else:
    app.secret_key = hashlib.sha256(os.urandom(32)).hexdigest()
    with open(_key_file, "w") as f:
        f.write(app.secret_key)
app.permanent_session_lifetime = __import__("datetime").timedelta(hours=8)

# 登录失败记录（简单限速）
_login_attempts = {}


# ─── 健康检查（运维探活，无需登录）───
@app.route("/healthz")
def healthz():
    try:
        db = get_db()
        db.execute("SELECT 1").fetchone()
        return jsonify({"status": "ok", "service": "wotu", "db": True}), 200
    except Exception:
        return jsonify({"status": "error", "service": "wotu", "db": False}), 500


# ─── 全局模板变量：备案号 / 系统配置 ───
@app.context_processor
def inject_global_config():
    try:
        cfg = dict(get_db().execute("SELECT key, value FROM system_config").fetchall())
    except Exception:
        cfg = {}
    return {"icp_no": cfg.get("icp_no", ""),
            "gongan_no": cfg.get("gongan_no", ""),
            "site_name": "沃土计划"}


# ─── 数据库 ───
def get_db():
    if "db" not in g:
        g.db = sqlite3.connect(DB_PATH, timeout=15)
        g.db.row_factory = sqlite3.Row
        # 多 worker 部署下降低写锁冲突
        try:
            g.db.execute("PRAGMA busy_timeout=15000")
            g.db.execute("PRAGMA journal_mode=WAL")
        except sqlite3.OperationalError:
            pass
    return g.db


@app.teardown_appcontext
def close_db(exc):
    db = g.pop("db", None)
    if db:
        db.close()


def hash_pwd(p):
    return hashlib.sha256(p.encode()).hexdigest()


# ─── 身份映射：stu001 ↔ S001 ───
def sid_for_user(user_id):
    """登录账号映射到业务 SID"""
    if user_id.startswith("stu"):
        return "S" + user_id[3:].zfill(3)
    return None


# ─── 登录装饰器 ───
def login_required(fn):
    @wraps(fn)
    def wrapper(*args, **kwargs):
        if "user_id" not in session:
            return redirect(url_for("login", next=request.path))
        return fn(*args, **kwargs)
    return wrapper


def role_required(*roles):
    def deco(fn):
        @wraps(fn)
        def wrapper(*args, **kwargs):
            if "user_id" not in session:
                return redirect(url_for("login"))
            if session.get("role") not in roles:
                flash("无权限访问该页面", "error")
                return redirect(url_for("dashboard"))
            return fn(*args, **kwargs)
        return wrapper
    return deco


def current_user():
    if "user_id" not in session:
        return None
    row = get_db().execute(
        "SELECT user_id, role, display_name FROM campus_user_role WHERE user_id=?",
        (session["user_id"],)).fetchone()
    return row


# ─── 审计日志（关键操作留痕）───
def _audit(db, operate_type, change_summary, sid=""):
    try:
        db.execute("""INSERT INTO campus_audit_log (sid, operator_id, operate_type, change_summary, operate_time)
                      VALUES (?,?,?,?,?)""",
            (sid, session.get("user_id", ""), operate_type, change_summary,
             datetime.now().strftime("%Y-%m-%d %H:%M:%S")))
        db.commit()
    except Exception:
        pass


def _get_config_int(db, key, default):
    r = db.execute("SELECT value FROM system_config WHERE key=?", (key,)).fetchone()
    try:
        return int(r["value"]) if r else default
    except (TypeError, ValueError):
        return default


# ─── 雷达图 SVG（内联，无外部依赖）───
def radar_svg(m1, m2, m3, m4, size=260):
    """四维雷达图：M1 上 / M2 右 / M3 下 / M4 左"""
    m1, m2, m3, m4 = (m1 or 0), (m2 or 0), (m3 or 0), (m4 or 0)
    cx, cy, R = 130, 130, 90
    axes = [
        ("M1", m1, -90),
        ("M2", m2,   0),
        ("M3", m3,  90),
        ("M4", m4, 180),
    ]
    def pt(val, angle_deg, r_scale=1.0):
        a = math.radians(angle_deg)
        r = (val / 100.0) * R * r_scale
        return cx + r * math.cos(a), cy + r * math.sin(a)

    parts = [f'<svg width="{size}" height="{size}" viewBox="0 0 260 260" xmlns="http://www.w3.org/2000/svg">']
    # 背景网格（3 层）
    for ring in (0.33, 0.66, 1.0):
        pts = []
        for _, _, ang in axes:
            x, y = pt(100, ang, ring)
            pts.append(f"{x:.1f},{y:.1f}")
        parts.append(f'<polygon points="{" ".join(pts)}" fill="none" stroke="#E5E7EB" stroke-width="1"/>')
    # 轴线
    for name, val, ang in axes:
        x, y = pt(100, ang)
        parts.append(f'<line x1="{cx}" y1="{cy}" x2="{x:.1f}" y2="{y:.1f}" stroke="#E5E7EB" stroke-width="1"/>')
        lx, ly = pt(118, ang)
        parts.append(f'<text x="{lx:.1f}" y="{ly:.1f}" text-anchor="middle" dominant-baseline="middle" '
                     f'font-size="12" font-weight="600" fill="#374151">{name}</text>')
        parts.append(f'<text x="{lx:.1f}" y="{ly+14:.1f}" text-anchor="middle" dominant-baseline="middle" '
                     f'font-size="10" fill="#9CA3AF">{val:.0f}</text>')
    # 数据多边形
    data_pts = []
    for _, val, ang in axes:
        x, y = pt(val, ang)
        data_pts.append(f"{x:.1f},{y:.1f}")
    parts.append(f'<polygon points="{" ".join(data_pts)}" fill="rgba(15,123,79,0.18)" stroke="#0F7B4F" stroke-width="2"/>')
    for _, val, ang in axes:
        x, y = pt(val, ang)
        parts.append(f'<circle cx="{x:.1f}" cy="{y:.1f}" r="3.5" fill="#0F7B4F"/>')
    parts.append("</svg>")
    return "".join(parts)


