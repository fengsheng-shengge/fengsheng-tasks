@app.route("/dashboard/student")
@login_required
@role_required("student")
def student_dashboard():
    uid = session["user_id"]
    sid = sid_for_user(uid) or uid
    db = get_db()

    # 最新有效成绩
    cert = db.execute(
        "SELECT * FROM campus_cert_result WHERE sid=? AND is_valid=1 "
        "ORDER BY cert_id DESC LIMIT 1", (sid,)).fetchone()

    # 学员姓名
    stu = db.execute("SELECT name FROM campus_student WHERE sid=?", (sid,)).fetchone()
    name = stu["name"] if stu else sid

    # 7 天任务完成状态
    tasks = []
    done_count = 0
    for tdef in TASK_DEFS:
        day = tdef["day"]
        total_deliv = len(tdef["deliverables"])
        # 实操：所有交付节点都提交了才算完成
        submitted = db.execute(
            "SELECT COUNT(DISTINCT deliverable_index) c FROM practice_submission WHERE sid=? AND day=?",
            (sid, day)).fetchone()["c"]
        practice_done = submitted >= total_deliv
        # 测验是否已做
        qr = db.execute(
            "SELECT score FROM campus_quiz_result WHERE sid=? AND quiz_group=?",
            (sid, tdef["paper"])).fetchone()
        quiz_done = bool(qr)
        quiz_score = qr["score"] if qr else None

        day_done = practice_done and quiz_done
        if day_done:
            done_count += 1
        sub = []
        sub.append(("学习材料", True, "已完成"))
        sub.append(("交付节点", practice_done, f"{submitted}/{total_deliv}已交" if submitted else "未提交"))
        sub.append(("知识测验", quiz_done, f"{quiz_score:.0f}分" if quiz_score else "未做"))

        tasks.append({
            "day": day, "title": tdef["title"], "module": tdef["module"],
            "paper": tdef["paper"], "done": day_done,
            "current": (day == done_count + 1 and not day_done),
            "subs": sub,
        })

    radar = radar_svg(
        cert["m1_score"] if cert else 0,
        cert["m2_score"] if cert else 0,
        cert["m3_score"] if cert else 0,
        cert["m4_score"] if cert else 0,
    )
    exam_cfg = db.execute("SELECT active_paper, is_open FROM exam_config WHERE id=1").fetchone()
    # 积分与排名（助教激励）
    points = _points_summary(db, sid)
    # 督导通知（助教发给我、待我跟进）
    my_supervisions = db.execute(
        "SELECT * FROM supervision_log WHERE sid=? AND status='pending' ORDER BY id DESC LIMIT 10",
        (sid,)).fetchall()
    # 我的标杆作品（被导师/助教推荐）
    my_showcases = db.execute("""
        SELECT sw.*, cs.name AS stu_name FROM showcase_work sw
        LEFT JOIN campus_student cs ON sw.sid=cs.sid
        WHERE sw.sid=? ORDER BY sw.id DESC LIMIT 10""", (sid,)).fetchall()
    # 校友身份卡（已结业入会）
    my_alumni = db.execute("SELECT * FROM alumni WHERE sid=?", (sid,)).fetchone()
    # 今日日程和公告
    my_class = db.execute("SELECT class_id FROM campus_student WHERE sid=?", (sid,)).fetchone()
    cid = my_class["class_id"] if my_class else "class01"
    today_schedule = db.execute("SELECT * FROM class_schedule WHERE class_id=? ORDER BY time_slot", (cid,)).fetchall()
    announcements = db.execute("SELECT * FROM announcement WHERE class_id=? ORDER BY created_at DESC LIMIT 5", (cid,)).fetchall()
    user = {"display_name": session.get("display_name"), "role": "student", "sid": sid}
    banner = {
        "title": "沃土计划 · 预备经纪人实训营",
        "vision": "让每一次实训都长出真本事：测知识、学方法、练技能、考能力、评画像，最终拿到一份能证明自己的能力档案。",
        "expect_title": "致学员 · 今天的演练，是明天的第一单",
        "expect_desc": "你将在 7 天里像真正的经纪人一样跑商圈、打电话、做楼书、接待客户。完成全部实操与考核，你将带着四维能力画像和上岗建议走出实训营——我们已经为你铺好「技能盘点 → 师傅结对 → 3 个月陪跑」的独立上岗之路。",
        "theme": "green",
        "features": [
            {"icon": "📚", "name": "每日任务", "desc": "学习→实操→测验闭环", "url": url_for("student_study")},
            {"icon": "🎤", "name": "实操演练", "desc": "录音/跑盘/话术交付", "url": url_for("student_practice")},
            {"icon": "📝", "name": "知识测验", "desc": "7天随堂测验", "url": url_for("student_quizzes")},
            {"icon": "📊", "name": "我的测评", "desc": "四维能力画像", "url": url_for("student_eval")},
            {"icon": "🎓", "name": "结业证书", "desc": "定级与上岗建议", "url": url_for("student_cert")},
            {"icon": "🚀", "name": "上岗陪跑", "desc": "结对师傅·3个月陪跑", "url": url_for("student_followup")},
        ],
    }
    return render_template("student_dashboard.html",
                           user=user, active="dashboard",
                           cert=cert or {}, tasks=tasks,
                           done_count=done_count, radar_svg=radar,
                           exam_paper=exam_cfg["active_paper"] if exam_cfg else None,
                           exam_open=bool(exam_cfg["is_open"]) if exam_cfg else False,
                           today_schedule=today_schedule, announcements=announcements,
                           points=points, my_supervisions=my_supervisions,
                           my_showcases=my_showcases, my_alumni=my_alumni,
                           banner=banner)


# ─── 做题：GET 展示题目 / POST 判分提交 ───
# ─── 每日任务详情 ───
@app.route("/day/<int:day_num>")
@login_required
@role_required("student")
def day_detail(day_num):
    if day_num < 1 or day_num > 7:
        flash("无效的天数", "error")
        return redirect(url_for("student_dashboard"))
    tdef = TASK_DEFS[day_num - 1]
    sid = sid_for_user(session["user_id"]) or session["user_id"]
    db = get_db()
    # 已提交的各交付节点
    submissions = {}
    for row in db.execute(
        "SELECT deliverable_index, content, attachment_path, created_at FROM practice_submission WHERE sid=? AND day=? ORDER BY id",
        (sid, day_num)).fetchall():
        submissions[row["deliverable_index"]] = {"content": row["content"], "attachment_path": row["attachment_path"], "created_at": row["created_at"]}
    # 测验成绩
    qr = db.execute(
        "SELECT score FROM campus_quiz_result WHERE sid=? AND quiz_group=?",
        (sid, tdef["paper"])).fetchone()
    return render_template("day_detail.html", tdef=tdef, day_num=day_num,
                           submissions=submissions, quiz_score=qr["score"] if qr else None)


@app.route("/day/<int:day_num>/practice", methods=["POST"])
@login_required
@role_required("student")
def practice_submit(day_num):
    content = request.form.get("content", "").strip()
    deliv_idx = int(request.form.get("deliverable_index", 0))
    if not content and "attachment" not in request.files:
        flash("请填写内容或上传附件", "error")
        return redirect(url_for("day_detail", day_num=day_num))
    sid = sid_for_user(session["user_id"]) or session["user_id"]
    db = get_db()
    # 处理文件上传
    attachment_path = None
    f = request.files.get("attachment")
    if f and f.filename:
        ext = os.path.splitext(f.filename)[1].lower()
        allowed = {".jpg", ".jpeg", ".png", ".gif", ".pdf", ".mp4", ".mov", ".doc", ".docx", ".txt", ".zip", ".pptx",
                   ".mp3", ".wav", ".m4a", ".aac", ".webm", ".ogg"}
        if ext not in allowed:
            flash(f"不支持的文件格式 {ext}，支持：图片/音频/视频/PDF/文档/zip", "error")
            return redirect(url_for("day_detail", day_num=day_num))
        fname = f"{sid}_d{day_num}_n{deliv_idx}_{datetime.now().strftime('%Y%m%d%H%M%S')}{ext}"
        f.save(os.path.join(UPLOAD_DIR, fname))
        attachment_path = fname
    # 同节点已有提交就更新，否则插入
    existing = db.execute(
        "SELECT id, attachment_path FROM practice_submission WHERE sid=? AND day=? AND deliverable_index=?",
        (sid, day_num, deliv_idx)).fetchone()
    now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    if existing:
        # 新上传附件则替换，否则保留原附件
        new_att = attachment_path or existing["attachment_path"]
        db.execute(
            "UPDATE practice_submission SET content=?, attachment_path=?, created_at=? WHERE id=?",
            (content, new_att, now, existing["id"]))
    else:
        db.execute(
            "INSERT INTO practice_submission (sid, day, deliverable_index, content, attachment_path, created_at) VALUES (?,?,?,?,?,?)",
            (sid, day_num, deliv_idx, content, attachment_path, now))
    db.commit()
    flash(f"交付节点「{TASK_DEFS[day_num-1]['deliverables'][deliv_idx]['name']}」已提交", "success")
    return redirect(url_for("day_detail", day_num=day_num))


@app.route("/quiz/<paper_id>", methods=["GET", "POST"])
@login_required
@role_required("student")
def quiz(paper_id):
    if paper_id not in CHOICE_DOCUMENTS:
        flash("无效的试卷编号", "error")
        return redirect(url_for("student_dashboard"))

    uid = session["user_id"]
    sid = sid_for_user(uid) or uid
    db = get_db()

    # POST：判分提交
    if request.method == "POST":
        total, score_sum, detail_rows = 0, 0.0, []
        for grp in CHOICE_DOCUMENTS[paper_id]:
            rows = db.execute(
                "SELECT qid, question_no, quiz_type, answer FROM quiz_bank_choice WHERE quiz_group=? ORDER BY question_no",
                (grp,)).fetchall()
            for row in rows:
                qid, qtype, correct_ans = row["qid"], row["quiz_type"], (row["answer"] or "").strip().upper()
                if qtype == "多选":
                    user_list = [v.upper() for v in request.form.getlist(f"q_{qid}")]
                    user_ans = "".join(sorted(user_list))
                    is_ok = bool(user_ans) and sorted(user_list) == sorted(correct_ans)
                else:
                    user_ans = (request.form.get(f"q_{qid}", "") or "").strip().upper()
                    is_ok = user_ans == correct_ans
                total += 1
                if is_ok:
                    score_sum += WEIGHT.get(qtype, 0)
                detail_rows.append((sid, paper_id, grp, row["question_no"], user_ans or None, 1 if is_ok else 0))

        # 必须答全36题
        if total < 36 or any(r[4] is None for r in detail_rows):
            flash("答题不完整，请完成全部36题后再提交", "error")
            return redirect(url_for("quiz", paper_id=paper_id))

        # UPSERT 主记录到 campus_quiz_result（quiz_group 用 paper_id）
        db.execute(
            "INSERT INTO campus_quiz_result (sid, quiz_group, score, create_at) VALUES (?, ?, ?, ?) "
            "ON CONFLICT(sid, quiz_group) DO UPDATE SET score=excluded.score, create_at=excluded.create_at",
            (sid, paper_id, round(score_sum, 2), datetime.now().strftime("%Y-%m-%d %H:%M:%S")))
        # 明细
        for r in detail_rows:
            db.execute(
                "INSERT OR IGNORE INTO quiz_choice_detail (sid, paper_id, quiz_group, question_no, user_answer, is_correct) VALUES (?,?,?,?,?,?)",
                r)
        db.commit()
        flash(f"{PAPER_TITLES[paper_id]} 提交成功，得分 {round(score_sum, 2)}", "success")
        return redirect(url_for("student_dashboard"))

    # GET：展示题目
    cfg = db.execute("SELECT active_paper, is_open FROM exam_config WHERE id=1").fetchone()
    is_exam_paper = cfg and paper_id == cfg["active_paper"]
    exam_locked = is_exam_paper and not cfg["is_open"]

    if exam_locked:
        flash("结训大考尚未开启，请等待项目组通知", "warn")
        return redirect(url_for("student_dashboard"))

    questions = []
    for grp in CHOICE_DOCUMENTS[paper_id]:
        rows = db.execute(
            "SELECT qid, quiz_group, question_no, quiz_type, category, content, opt_a, opt_b, opt_c, opt_d, answer, explanation "
            "FROM quiz_bank_choice WHERE quiz_group=? ORDER BY question_no", (grp,)).fetchall()
        for r in rows:
            questions.append(dict(r))

    # 查是否已做过
    done_row = db.execute(
        "SELECT score FROM campus_quiz_result WHERE sid=? AND quiz_group=?", (sid, paper_id)).fetchone()
    done_score = done_row["score"] if done_row else None

    return render_template("quiz.html", paper_id=paper_id,
                           paper_title=PAPER_TITLES[paper_id],
                           questions=questions, total=len(questions),
                           done_score=done_score,
                           exam_mode=is_exam_paper)


# ─── PM 工作台 ───
def latest_certs(db):
    """每个 sid 取最新一条 is_valid=1"""
    rows = db.execute(
        "SELECT c.* FROM campus_cert_result c "
        "INNER JOIN (SELECT sid, MAX(cert_id) AS max_id FROM campus_cert_result WHERE is_valid=1 GROUP BY sid) m "
        "ON c.cert_id = m.max_id ORDER BY c.sid").fetchall()
    return rows


@app.route("/dashboard/pm")
@login_required
@role_required("pm")
def pm_dashboard():
    db = get_db()
    rows = latest_certs(db)
    risk_sids = {r["sid"] for r in db.execute("SELECT DISTINCT sid FROM campus_risk_action").fetchall()}
    name_map = {r["sid"]: r["name"] for r in db.execute("SELECT sid, name FROM campus_student").fetchall()}

    table_rows = []
    grades = {"S": 0, "A": 0, "B": 0, "C": 0, "D": 0}
    pass_count = 0
    for r in rows:
        g = r["grade"] or "D"
        grades[g] = grades.get(g, 0) + 1
        if r["is_pass"]:
            pass_count += 1
        table_rows.append({
            "sid": r["sid"], "name": name_map.get(r["sid"]),
            "m1_score": r["m1_score"], "m2_score": r["m2_score"],
            "m3_score": r["m3_score"], "m4_score": r["m4_score"],
            "total_score": r["total_score"], "grade": g,
            "is_pass": r["is_pass"], "cert_no": r["cert_no"],
            "has_risk": r["sid"] in risk_sids,
        })

    valid = len(rows)
    stats = {
        "total": db.execute("SELECT COUNT(*) c FROM campus_student").fetchone()["c"] or valid,
        "valid": valid,
        "pass_count": pass_count,
        "pass_rate": round(pass_count / valid * 100, 1) if valid else 0,
        "grade_s": grades.get("S", 0),
        "grade_a": grades.get("A", 0),
        "grade_b": grades.get("B", 0),
        "grade_c": grades.get("C", 0),
        "grade_a_plus": grades.get("S", 0) + grades.get("A", 0),
        "risk_count": len(risk_sids),
    }
    user = {"display_name": session.get("display_name"), "role": "pm"}
    banner = {
        "title": "沃土计划 · 预备经纪人实训营",
        "vision": "项目组是沃土的总指挥部：从实训运营、人才评价到上岗陪跑与校友生态，让每一批学员都形成可沉淀的组织资产。",
        "expect_title": "致项目组 · 你是这个生态的掌舵人",
        "expect_desc": "你俯瞰全营：把握班级通过率与质量红线，跟踪结业学员的上岗转化，终审优秀学员与标杆案例，并把积分规则等业务参数握在手中。数据在，则决策有据；档案在，则人才可追。",
        "theme": "rose",
        "features": [
            {"icon": "📊", "name": "数据总览", "desc": "通过率·定级分布", "url": url_for("pm_dashboard")},
            {"icon": "🗂", "name": "学员档案", "desc": "画像·实操·陪跑", "url": url_for("pm_students")},
            {"icon": "🚀", "name": "上岗跟踪", "desc": "结对·陪跑看板", "url": url_for("pm_onboard")},
            {"icon": "🏆", "name": "优秀学员", "desc": "S/A候选·提名终审", "url": url_for("pm_excellent")},
            {"icon": "🎓", "name": "校友会", "desc": "校友档案·表现记录", "url": url_for("pm_alumni")},
            {"icon": "📚", "name": "标杆案例集", "desc": "作品库·zip导出", "url": url_for("pm_showcase")},
        ],
    }
    return render_template("pm_dashboard.html",
                           user=user, active="pm_dashboard",
                           stats=stats, rows=table_rows, banner=banner)


# ─── 交付包导出：四件套 zip ───
@app.route("/api/pm/export")
@login_required
def pm_export():
    if session.get("role") != "pm":
        return jsonify({"error": "仅项目组可操作"}), 403
    db = get_db()
    rows = latest_certs(db)
    risk_sids = {r["sid"] for r in db.execute("SELECT DISTINCT sid FROM campus_risk_action").fetchall()}
    name_map = {r["sid"]: r["name"] for r in db.execute("SELECT sid, name FROM campus_student").fetchall()}

    # ── summary.csv ──
    grades = {"S": 0, "A": 0, "B": 0, "C": 0, "D": 0}
    pass_count = 0
    m_sum = [0.0, 0.0, 0.0, 0.0]
    for r in rows:
        g = r["grade"] or "D"
        grades[g] = grades.get(g, 0) + 1
        if r["is_pass"]:
            pass_count += 1
        for i, k in enumerate(["m1_score", "m2_score", "m3_score", "m4_score"]):
            m_sum[i] += r[k] or 0
    valid = len(rows)
    summary_buf = io.StringIO()
    w = csv.writer(summary_buf)
    w.writerow(["沃土计划 · 交付包汇总"])
    w.writerow(["导出时间", datetime.now().strftime("%Y-%m-%d %H:%M:%S")])
    w.writerow(["有效学员数", valid])
    w.writerow(["通过人数", pass_count])
    w.writerow(["通过率%", round(pass_count / valid * 100, 1) if valid else 0])
    w.writerow(["定级分布", f"S={grades.get('S',0)}  A={grades.get('A',0)}  B={grades.get('B',0)}  C={grades.get('C',0)}  D={grades.get('D',0)}"])
    w.writerow(["风险人数", len(risk_sids)])
    w.writerow(["四维均值",
                f"M1={m_sum[0]/valid:.1f}" if valid else "M1=—",
                f"M2={m_sum[1]/valid:.1f}" if valid else "M2=—",
                f"M3={m_sum[2]/valid:.1f}" if valid else "M3=—",
                f"M4={m_sum[3]/valid:.1f}" if valid else "M4=—"])

    # ── detail.csv ──
    detail_buf = io.StringIO()
    w = csv.writer(detail_buf)
    w.writerow(["sid", "姓名", "M1价值观", "M2业务实操", "M3 AI应用", "M4媒体作品",
                "综合分", "定级", "是否通过", "证书号", "风险标记"])
    for r in rows:
        w.writerow([
            r["sid"], name_map.get(r["sid"], ""),
            r["m1_score"] or 0, r["m2_score"] or 0, r["m3_score"] or 0, r["m4_score"] or 0,
            r["total_score"] or 0, r["grade"] or "D",
            "通过" if r["is_pass"] else "未通过",
            r["cert_no"] or "",
            "风险" if r["sid"] in risk_sids else "",
        ])

    # ── audit.csv ──
    audit_buf = io.StringIO()
    w = csv.writer(audit_buf)
    w.writerow(["时间", "学员SID", "操作人", "操作类型", "内容"])
    for r in db.execute(
        "SELECT operate_time, sid, operator_id, operate_type, change_summary "
        "FROM campus_audit_log ORDER BY operate_time DESC LIMIT 500"):
        w.writerow([r["operate_time"], r["sid"] or "", r["operator_id"] or "",
                    r["operate_type"], r["change_summary"] or ""])

    # ── report.html（内联 SVG 雷达，可打印）──
    cards = []
    for r in rows:
        radar = radar_svg(r["m1_score"], r["m2_score"], r["m3_score"], r["m4_score"], size=220)
        g = r["grade"] or "D"
        g_color = {"S": "#92400E", "A": "#166534", "B": "#1E40AF", "C": "#991B1B", "D": "#4B5563"}.get(g, "#4B5563")
        risk = r["sid"] in risk_sids
        cards.append(f"""
        <div class="report-card">
          <div class="report-head">
            <div>
              <div class="report-name">{name_map.get(r['sid'], '学员')}</div>
              <div class="report-sid">{r['sid']} · 证书号 {r['cert_no'] or '未签发'}</div>
            </div>
            <div class="report-grade" style="color:{g_color}">{g}</div>
          </div>
          <div class="report-body">
            {radar}
            <div class="report-scores">
              <div class="rs-row"><span>M1 价值观素养</span><b>{r['m1_score'] or 0:.1f}</b></div>
              <div class="rs-row"><span>M2 业务实操</span><b>{r['m2_score'] or 0:.1f}</b></div>
              <div class="rs-row"><span>M3 AI 应用</span><b>{r['m3_score'] or 0:.1f}</b></div>
              <div class="rs-row"><span>M4 媒体作品</span><b>{r['m4_score'] or 0:.1f}</b></div>
              <div class="rs-row total"><span>综合分</span><b>{r['total_score'] or 0:.1f}</b></div>
              <div class="rs-row"><span>是否通过</span><b>{'通过' if r['is_pass'] else '未通过'}</b></div>
              {'<div class="rs-row risk"><span>风险提示</span><b>需关注</b></div>' if risk else ''}
            </div>
          </div>
        </div>""")

    report_html = f"""<!DOCTYPE html>
<html lang="zh-CN"><head><meta charset="UTF-8"><title>沃土计划 · 学员能力档案</title>
<style>
  body {{ font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif; background:#F3F4F6; margin:0; padding:24px; color:#111827; }}
  h1 {{ font-size:22px; margin:0 0 4px; }} .meta {{ color:#6B7280; font-size:13px; margin-bottom:22px; }}
  .grid {{ display:grid; grid-template-columns: repeat(auto-fill, minmax(420px, 1fr)); gap:18px; }}
  .report-card {{ background:#fff; border:1px solid #E5E7EB; border-radius:10px; padding:20px; break-inside:avoid; }}
  .report-head {{ display:flex; justify-content:space-between; align-items:flex-start; border-bottom:1px solid #E5E7EB; padding-bottom:12px; margin-bottom:14px; }}
  .report-name {{ font-size:17px; font-weight:700; }} .report-sid {{ font-size:12px; color:#6B7280; margin-top:2px; }}
  .report-grade {{ font-size:36px; font-weight:800; line-height:1; }}
  .report-body {{ display:flex; gap:18px; align-items:center; }}
  .report-scores {{ flex:1; }}
  .rs-row {{ display:flex; justify-content:space-between; padding:6px 0; border-bottom:1px solid #F3F4F6; font-size:13.5px; }}
  .rs-row.total b {{ color:#0F7B4F; font-size:16px; }} .rs-row.risk b {{ color:#DC2626; }}
  @media print {{ body {{ background:#fff; padding:0; }} .report-card {{ border:none; }} }}
</style></head>
<body>
<h1>沃土计划 · 学员能力档案包</h1>
<div class="meta">导出时间 {datetime.now().strftime("%Y-%m-%d %H:%M:%S")} · 共 {valid} 人 · 数据来源 campus_cert_result（is_valid=1）</div>
<div class="grid">{''.join(cards)}</div>
</body></html>"""

    # ── 打包 zip ──
    mem = io.BytesIO()
    with zipfile.ZipFile(mem, "w", zipfile.ZIP_DEFLATED) as zf:
        zf.writestr("summary.csv", "\ufeff" + summary_buf.getvalue())
        zf.writestr("detail.csv", "\ufeff" + detail_buf.getvalue())
        zf.writestr("audit.csv", "\ufeff" + audit_buf.getvalue())
        zf.writestr("report.html", report_html)
    mem.seek(0)
    fname = f"wotu_delivery_{datetime.now().strftime('%Y%m%d_%H%M%S')}.zip"
    return Response(
        mem.getvalue(),
        mimetype="application/zip",
        headers={"Content-Disposition": f"attachment;filename={fname}"},
    )


