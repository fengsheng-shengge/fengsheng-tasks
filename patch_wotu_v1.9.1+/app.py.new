@app.route("/material/upload", methods=["POST"])
@login_required
@role_required("teacher", "pm")
def material_upload():
    f = request.files.get("file")
    if not f or not f.filename:
        flash("请选择文件", "error")
        return redirect(url_for("student_study"))
    ext = os.path.splitext(f.filename)[1].lower()
    allowed = {".pdf",".doc",".docx",".ppt",".pptx",".jpg",".jpeg",".png",".mp4",".mov",".zip",".txt"}
    if ext not in allowed:
        flash("不支持的文件格式", "error")
        return redirect(url_for("student_study"))
    fname = f"material_{datetime.now().strftime('%Y%m%d%H%M%S')}{ext}"
    f.save(os.path.join(UPLOAD_DIR, fname))
    db = get_db()
    db.execute("INSERT INTO course_material (day, title, description, file_path, file_type, uploaded_by, created_at) VALUES (?,?,?,?,?,?,?)",
        (request.form.get("day",1), request.form.get("title",""), request.form.get("description",""),
         fname, ext.lstrip("."), session.get("display_name"),
         datetime.now().strftime("%Y-%m-%d %H:%M:%S")))
    db.commit()
    flash("课件已上传", "success")
    return redirect(url_for("student_study"))


