# ─── 路由：登录 ───
@app.route("/login", methods=["GET", "POST"])
def login():
    demo_mode = _get_config_int(get_db(), "demo_mode", 1)
    if request.method == "POST":
        uid = request.form.get("user_id", "").strip()
        pwd = request.form.get("password", "")
        # 简单限速：同一IP 5分钟内失败5次锁定
        ip = request.remote_addr
        now = datetime.now()
        attempts = _login_attempts.get(ip, [])
        attempts = [t for t in attempts if (now - t).total_seconds() < 300]
        if len(attempts) >= 5:
            flash("尝试次数过多，请5分钟后再试", "error")
            return render_template("login.html", demo_mode=demo_mode), 429
        row = get_db().execute(
            "SELECT user_id, role, display_name, password_hash, managed_class_ids FROM campus_user_role WHERE user_id=?",
            (uid,)).fetchone()
        if not row or row["password_hash"] != hash_pwd(pwd):
            attempts.append(now)
            _login_attempts[ip] = attempts
            flash("账号或密码错误", "error")
            return render_template("login.html", demo_mode=demo_mode), 401
        # 登录成功清空失败记录
        _login_attempts.pop(ip, None)
        session.permanent = True
        session["user_id"] = row["user_id"]
        session["role"] = row["role"]
        session["display_name"] = row["display_name"]
        session["managed_class_ids"] = row["managed_class_ids"] or ""
        return redirect(request.args.get("next") or url_for("dashboard"))
    return render_template("login.html", demo_mode=demo_mode)


@app.route("/logout")
def logout():
    session.clear()
    flash("已退出登录", "info")
    return redirect(url_for("login"))


# ─── 学生自助注册（公开）───
@app.route("/register", methods=["GET", "POST"])
def register():
    """新学员自助注册入口：填姓名+手机号+学校 → 自动生成 stuXXX 账号 → 跳到登录页"""
    if request.method == "POST":
        name = request.form.get("name", "").strip()
        phone = request.form.get("phone", "").strip()
        school = request.form.get("school", "").strip()
        pwd = request.form.get("password", "").strip()

        errors = []
        if not name:
            errors.append("请填写姓名")
        if not phone or not phone.isdigit() or len(phone) < 11:
            errors.append("请填写正确的手机号")
        if not pwd or len(pwd) < 6:
            errors.append("密码至少 6 位")
        if errors:
            for e in errors:
                flash(e, "error")
            return render_template("register.html", name=name, phone=phone, school=school), 400

        db = get_db()
        # 手机号去重
        exists = db.execute("SELECT sid FROM campus_student WHERE phone=?", (phone,)).fetchone()
        if exists:
            flash("该手机号已注册，请直接登录", "error")
            return render_template("register.html", name=name, school=school), 400

        # 生成账号 stuXXX（取最大 stu 序号 +1）
        max_uid = db.execute(
            "SELECT user_id FROM campus_user_role WHERE user_id LIKE 'stu%' "
            "ORDER BY CAST(substr(user_id,4) AS INTEGER) DESC LIMIT 1").fetchone()
        next_num = int(max_uid["user_id"][3:]) + 1 if max_uid else 1
        new_uid = f"stu{next_num:03d}"
        new_sid = f"S{next_num:03d}"

        db.execute(
            "INSERT INTO campus_user_role (user_id, role, display_name, password_hash) "
            "VALUES (?,?,?,?)",
            (new_uid, "student", name, hash_pwd(pwd)))
        db.execute(
            "INSERT INTO campus_student (sid, name, school, phone, created_at) "
            "VALUES (?,?,?,?,?)",
            (new_sid, name, school, phone, datetime.now().strftime("%Y-%m-%d %H:%M:%S")))
        db.commit()

        flash(f"注册成功！账号 {new_uid}，初始密码已按您填的设置。请登录进入实训营。", "success")
        return redirect(url_for("login"))

    return render_template("register.html")


# ─── 根路径：未登录 → 报名引导，已登录 → dashboard ───
@app.route("/")
def index():
    if "user_id" in session:
        return redirect(url_for("dashboard"))
    return render_template("landing.html")


@app.route("/dashboard")
@login_required
def dashboard():
    role = session.get("role")
    if role == "student":
        return redirect(url_for("student_dashboard"))
    elif role == "pm":
        return redirect(url_for("pm_dashboard"))
    elif role == "coach":
        return redirect(url_for("coach_dashboard"))
    elif role == "expert":
        return redirect(url_for("expert_dashboard"))
    elif role == "teacher":
        return redirect(url_for("teacher_dashboard"))
    elif role == "mentor":
        return redirect(url_for("mentor_dashboard"))
    else:
        flash("该角色工作台暂未开放", "info")
        return redirect(url_for("login"))


