# ─── 助教工作台 ───
@app.route("/dashboard/coach")
@login_required
@role_required("coach")
def coach_dashboard():
    db = get_db()
    # 所有学员
    students = db.execute("SELECT sid, name FROM campus_student ORDER BY sid").fetchall()
    # 学习活跃度：最近 7 天有学习打卡的学员（活跃天数）
    seven_days = (datetime.now() - timedelta(days=7)).strftime("%Y-%m-%d")
    active_map = {r["sid"]: r["c"] for r in db.execute(
        "SELECT sid, COUNT(DISTINCT substr(created_at,1,10)) c FROM study_activity "
        "WHERE created_at >= ? AND act_type='study_checkin' GROUP BY sid", (seven_days,)).fetchall()}
    # 所有提交+审核
    subs = db.execute("""
        SELECT ps.*, pr.score, pr.comment, pr.reviewer, pr.reviewed_at
        FROM practice_submission ps
        LEFT JOIN practice_review pr ON ps.id = pr.submission_id
    """).fetchall()
    # 索引: (sid, day, node) -> sub
    sub_map = {}
    for s in subs:
        sub_map[(s["sid"], s["day"], s["deliverable_index"] or 0)] = s
    # 构建矩阵
    matrix = []
    total_nodes = 0
    pending_nodes = 0
    for stu in students:
        row = {"sid": stu["sid"], "name": stu["name"], "days": []}
        for tdef in TASK_DEFS:
            day = tdef["day"]
            nodes = []
            for j, d in enumerate(tdef["deliverables"]):
                total_nodes += 1
                s = sub_map.get((stu["sid"], day, j))
                node = {"name": d["name"], "submitted": bool(s),
                        "reviewed": bool(s and s["reviewed_at"]),
                        "score": s["score"] if s else None,
                        "sub_id": s["id"] if s else None}
                if s and not s["reviewed_at"]:
                    pending_nodes += 1
                nodes.append(node)
            row["days"].append({"day": day, "title": tdef["title"], "nodes": nodes})
        matrix.append(row)
    reviewed_nodes = total_nodes - pending_nodes
    deliv_names = {}
    for i, t in enumerate(TASK_DEFS):
        for j, d in enumerate(t["deliverables"]):
            deliv_names[(i+1, j)] = d["name"]
    user = {"display_name": session.get("display_name"), "role": "coach"}
    banner = {
        "title": "沃土计划 · 预备经纪人实训营",
        "vision": "助教是「教—练—评」闭环的引擎：用带教指南带节奏，用督导纠偏差，用审核把质量，用积分与评选点燃动力。",
        "expect_title": "致助教 · 你是学员从「知道」到「做到」的摆渡人",
        "expect_desc": "7 天实训里，学员能不能把话术变成真本事，很大程度取决于你的带练密度。请按任务指南推进三环节带教，及时督导预警学员、认真审核每份实操，并用积分激励和优秀评选让每一个进步都被看见。",
        "theme": "purple",
        "features": [
            {"icon": "📖", "name": "任务指南", "desc": "带教三环节·Day1-7", "url": url_for("coach_task_guide")},
            {"icon": "📡", "name": "督导工作台", "desc": "预警五色·写督导", "url": url_for("coach_supervise")},
            {"icon": "📏", "name": "评分锚点", "desc": "P0服务动作量化参照", "url": url_for("coach_rubric")},
            {"icon": "🏅", "name": "积分激励", "desc": "结算·手动加减·排行", "url": url_for("coach_points")},
            {"icon": "🏆", "name": "优秀评选", "desc": "轮次提名·标杆候选", "url": url_for("coach_excellent")},
            {"icon": "🗂", "name": "学员总览", "desc": "带练矩阵·交付节点", "url": url_for("coach_dashboard")},
        ],
    }
    return render_template("coach_dashboard.html", matrix=matrix,
                           pending=pending_nodes, reviewed=reviewed_nodes,
                           total=total_nodes, deliv_names=deliv_names, tasks=TASK_DEFS,
                           user=user, active="coach_dashboard",
                           day_titles={i+1: TASK_DEFS[i]["title"] for i in range(7)},
                           active_map=active_map,
                           banner=banner)


@app.route("/coach/review/<int:sub_id>", methods=["GET", "POST"])
@login_required
@role_required("coach")
def coach_review(sub_id):
    db = get_db()
    row = db.execute("""
        SELECT ps.*, cs.name as student_name
        FROM practice_submission ps
        LEFT JOIN campus_student cs ON ps.sid = cs.sid
        WHERE ps.id=?""", (sub_id,)).fetchone()
    if not row:
        flash("提交记录不存在", "error")
        return redirect(url_for("coach_dashboard"))

    if request.method == "POST":
        score = int(request.form.get("score", 0))
        comment = request.form.get("comment", "").strip()
        reviewer = session.get("display_name", session["user_id"])
        # 演练节点能力维度分（可选）
        def _f(v):
            try:
                return int(float(v))
            except (TypeError, ValueError):
                return None
        drill_speak = _f(request.form.get("drill_speak"))
        drill_content = _f(request.form.get("drill_content"))
        drill_logic = _f(request.form.get("drill_logic"))
        # 已有审核记录就更新，否则插入
        existing = db.execute("SELECT id FROM practice_review WHERE submission_id=?", (sub_id,)).fetchone()
        if existing:
            db.execute("UPDATE practice_review SET score=?, comment=?, reviewer=?, reviewed_at=?, drill_speak=?, drill_content=?, drill_logic=? WHERE submission_id=?",
                       (score, comment, reviewer, datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
                        drill_speak, drill_content, drill_logic, sub_id))
        else:
            db.execute("INSERT INTO practice_review (submission_id, sid, day, score, comment, reviewer, reviewed_at, drill_speak, drill_content, drill_logic) VALUES (?,?,?,?,?,?,?,?,?,?)",
                       (sub_id, row["sid"], row["day"], score, comment, reviewer,
                        datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
                        drill_speak, drill_content, drill_logic))
        db.commit()
        flash("审核完成", "success")
        return redirect(url_for("coach_dashboard"))

    review = db.execute("SELECT * FROM practice_review WHERE submission_id=?", (sub_id,)).fetchone()
    tdef = TASK_DEFS[row["day"] - 1]
    deliv = tdef["deliverables"][row["deliverable_index"]] if (row["deliverable_index"] is not None and row["deliverable_index"] < len(tdef["deliverables"])) else None
    user = {"display_name": session.get("display_name"), "role": "coach"}
    return render_template("coach_review.html", sub=row, review=review,
                           tdef=tdef, deliv=deliv, user=user, active="coach_dashboard",
                           day_titles={i+1: TASK_DEFS[i]["title"] for i in range(7)})


# ═══ 助教：任务指南 / 督导工作台 / 积分激励 / 优秀评选 ═══

def _points_summary(db, sid):
    """学员积分汇总与排名"""
    rows = db.execute("SELECT sid, SUM(points) AS total FROM points_record GROUP BY sid").fetchall()
    ranking = sorted(rows, key=lambda r: r["total"] or 0, reverse=True)
    my_total = db.execute("SELECT COALESCE(SUM(points),0) FROM points_record WHERE sid=?", (sid,)).fetchone()[0]
    my_rank = next((i+1 for i, r in enumerate(ranking) if r["sid"] == sid), None)
    detail = db.execute("SELECT * FROM points_record WHERE sid=? ORDER BY id DESC LIMIT 20", (sid,)).fetchall()
    return {"total": my_total, "rank": my_rank, "count": len(ranking), "detail": detail}


