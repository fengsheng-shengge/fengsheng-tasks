@app.route("/teacher/followup/save", methods=["POST"])
@login_required
@role_required("teacher")
def teacher_followup_save():
    db = get_db()
    sid = request.form.get("sid","")
    month_no = int(request.form.get("month_no","1"))
    # 师傅/店长填写（学员自评由学员端填写）
    mentor_score = request.form.get("mentor_score") or None
    store_score = request.form.get("store_score") or None
    goal = request.form.get("goal","")
    task_list = request.form.get("task_list","")
    comment = request.form.get("comment","")
    db.execute("""INSERT INTO monthly_followup (sid, month_no, goal, task_list, mentor_score, store_score, mentor_comment, status, created_at)
                  VALUES (?,?,?,?,?,?,?,?,?)
                  ON CONFLICT(sid, month_no) DO UPDATE SET
                    goal=excluded.goal, task_list=excluded.task_list,
                    mentor_score=excluded.mentor_score, store_score=excluded.store_score,
                    mentor_comment=excluded.mentor_comment,
                    status=excluded.status""",
        (sid, month_no, goal, task_list,
         int(mentor_score) if mentor_score else None,
         int(store_score) if store_score else None,
         comment,
         "done" if (mentor_score and store_score) else "pending",
         datetime.now().strftime("%Y-%m-%d %H:%M:%S")))
    db.commit()
    flash(f"第{month_no}个月评估已保存", "success")
    return redirect(url_for("teacher_followup", sid=sid))


# ═══ 业务导师角色（师傅/雇主/店长）═══
@app.route("/dashboard/mentor")
@login_required
@role_required("mentor")
def mentor_dashboard():
    db = get_db()
    mentor_id = session["user_id"]
    # 我的学员（active 结对）
    students = db.execute("""
        SELECT m.sid, s.name, s.school, s.major, s.student_status,
               c.grade, c.cert_no,
               (SELECT COUNT(*) FROM monthly_followup f WHERE f.sid=m.sid AND f.status='done') AS done_months,
               (SELECT COUNT(*) FROM monthly_followup f WHERE f.sid=m.sid) AS total_months
        FROM mentorship m
        LEFT JOIN campus_student s ON m.sid=s.sid
        LEFT JOIN campus_cert_result c ON c.sid=m.sid AND c.cert_id = (
            SELECT MAX(cert_id) FROM campus_cert_result c2 WHERE c2.sid=m.sid AND c2.is_valid=1)
        WHERE m.mentor_id=? AND m.status='active' ORDER BY m.sid""", (mentor_id,)).fetchall()
    # 待指导（有月评估未填 mentor_score）
    pending = db.execute("""
        SELECT f.sid, f.month_no, f.goal, s.name FROM monthly_followup f
        JOIN mentorship m ON f.sid=m.sid
        JOIN campus_student s ON f.sid=s.sid
        WHERE m.mentor_id=? AND f.mentor_score IS NULL ORDER BY f.sid, f.month_no""", (mentor_id,)).fetchall()
    profile = db.execute("SELECT * FROM mentor_profile WHERE mentor_id=?", (mentor_id,)).fetchone()
    banner = {
        "title": "沃土计划 · 预备经纪人实训营",
        "vision": "业务导师是把实训营的「合格」变成门店的「胜任」：用真实业务带教，让徒弟三个月后能独立开单。",
        "expect_title": "致业务导师 · 把徒弟带成能独当一面的经纪人",
        "expect_desc": "你接手的是已通过考核的学员。请用月度目标带节奏、用真实场景做示范、用表现记录留痕迹，并在关键时刻向项目组推荐值得全营学习的标杆作品——徒弟的每一次成长，都会被系统与校友会记住。",
        "theme": "orange",
        "features": [
            {"icon": "🧑‍🤝‍🧑", "name": "我的学员", "desc": "结对带教·进度一览", "url": url_for("mentor_dashboard")},
            {"icon": "📋", "name": "月度指导", "desc": "目标制定·评分评价", "url": url_for("mentor_dashboard")},
            {"icon": "📈", "name": "上岗表现", "desc": "师傅/店长/雇主记录", "url": url_for("mentor_dashboard")},
            {"icon": "🏆", "name": "标杆推荐", "desc": "推荐优秀作品", "url": url_for("mentor_showcase")},
        ],
    }
    return render_template("mentor_dashboard.html", students=students, pending=pending, profile=profile,
                           user={"display_name":session.get("display_name"),"role":"mentor"},
                           active="mentor_dashboard", banner=banner)


@app.route("/mentor/student/<sid>")
@login_required
@role_required("mentor")
def mentor_student_detail(sid):
    db = get_db()
    mentor_id = session["user_id"]
    # 校验结对关系
    pair = db.execute("SELECT * FROM mentorship WHERE sid=? AND mentor_id=? AND status='active'",
                      (sid, mentor_id)).fetchone()
    if not pair:
        flash("无权查看该学员", "error")
        return redirect(url_for("mentor_dashboard"))
    stu = db.execute("SELECT * FROM campus_student WHERE sid=?", (sid,)).fetchone()
    cert = db.execute("SELECT * FROM campus_cert_result WHERE sid=? AND is_valid=1 ORDER BY cert_id DESC LIMIT 1",
                      (sid,)).fetchone()
    followups = db.execute("SELECT * FROM monthly_followup WHERE sid=? ORDER BY month_no", (sid,)).fetchall()
    performances = db.execute("SELECT * FROM alumni_performance WHERE sid=? ORDER BY record_month DESC", (sid,)).fetchall()
    # 学员提交的作品（供导师查看/推荐标杆）
    works = db.execute("""SELECT ps.*, tdef.title AS task_title FROM practice_submission ps
                          JOIN campus_task tdef ON ps.day=tdef.day_no
                          WHERE ps.sid=? AND ps.attachment_path IS NOT NULL ORDER BY ps.day""", (sid,)).fetchall()
    showcased = {w["attachment_path"] for w in db.execute(
        "SELECT attachment_path FROM showcase_work WHERE sid=?", (sid,)).fetchall()}
    return render_template("mentor_student_detail.html", stu=stu, cert=cert or {},
                           followups=followups, performances=performances,
                           works=works, showcased=showcased, pair=pair,
                           user={"display_name":session.get("display_name"),"role":"mentor"},
                           active="mentor_dashboard")


@app.route("/mentor/eval", methods=["POST"])
@login_required
@role_required("mentor")
def mentor_eval():
    db = get_db()
    sid = request.form.get("sid","")
    month_no = int(request.form.get("month_no","1"))
    score = int(request.form.get("score","0"))
    comment = request.form.get("comment","")
    guidance = request.form.get("guidance","")
    mentor_id = session["user_id"]
    pair = db.execute("SELECT * FROM mentorship WHERE sid=? AND mentor_id=? AND status='active'",
                      (sid, mentor_id)).fetchone()
    if not pair:
        flash("无权操作该学员", "error")
        return redirect(url_for("mentor_dashboard"))
    db.execute("""INSERT INTO monthly_followup (sid, month_no, mentor_score, mentor_comment, status, created_at)
                  VALUES (?,?,?,?,?,?)
                  ON CONFLICT(sid, month_no) DO UPDATE SET
                    mentor_score=excluded.mentor_score,
                    mentor_comment=excluded.mentor_comment,
                    status=CASE WHEN monthly_followup.store_score IS NOT NULL THEN 'done' ELSE 'pending' END""",
        (sid, month_no, score, comment + ("\n【指导】" + guidance if guidance else ""),
         "done" if request.form.get("store_confirmed") else "pending",
         datetime.now().strftime("%Y-%m-%d %H:%M:%S")))
    db.commit()
    flash(f"已提交第{month_no}个月指导评价", "success")
    return redirect(url_for("mentor_student_detail", sid=sid))


@app.route("/mentor/performance", methods=["POST"])
@login_required
@role_required("mentor")
def mentor_performance():
    db = get_db()
    sid = request.form.get("sid","")
    record_month = request.form.get("record_month","")
    score = int(request.form.get("performance_score","0"))
    tags = request.form.get("metric_tags","")
    comment = request.form.get("comment","")
    role_type = request.form.get("role_type","师傅")
    mentor_id = session["user_id"]
    pair = db.execute("SELECT * FROM mentorship WHERE sid=? AND mentor_id=? AND status='active'",
                      (sid, mentor_id)).fetchone()
    if not pair:
        flash("无权操作该学员", "error")
        return redirect(url_for("mentor_dashboard"))
    db.execute("""INSERT INTO alumni_performance (sid, record_month, performance_score, metric_tags, comment, evaluator, role_type, created_at)
                  VALUES (?,?,?,?,?,?,?,?)""",
        (sid, record_month, score, tags, comment, session.get("display_name") or mentor_id,
         role_type, datetime.now().strftime("%Y-%m-%d %H:%M:%S")))
    db.commit()
    _audit(db, "上岗表现", f"{record_month} 表现分 {score}（{role_type}）", sid)
    flash("上岗表现记录已保存", "success")
    return redirect(url_for("mentor_student_detail", sid=sid))


@app.route("/mentor/showcase", methods=["POST"])
@login_required
@role_required("mentor")
def mentor_showcase():
    db = get_db()
    sid = request.form.get("sid","")
    attachment = request.form.get("attachment_path","")
    day_no = request.form.get("day_no","")
    title = request.form.get("title","")
    desc = request.form.get("desc","")
    category = request.form.get("category","")
    reason = request.form.get("recommend_reason","") or desc
    mentor_id = session["user_id"]
    pair = db.execute("SELECT * FROM mentorship WHERE sid=? AND mentor_id=? AND status='active'",
                      (sid, mentor_id)).fetchone()
    if not pair:
        flash("无权操作该学员", "error")
        return redirect(url_for("mentor_dashboard"))
    # 媒体类型推断
    ext = os.path.splitext(attachment)[1].lower()
    media = {"mp3":"audio","wav":"audio","m4a":"audio","mp4":"video","mov":"video","jpg":"image","jpeg":"image","png":"image","gif":"image","pdf":"pdf","zip":"zip","doc":"doc","docx":"doc"}.get(ext, "other")
    db.execute("""INSERT INTO showcase_work (sid, title, description, day_no, deliverable_index, media_type, attachment_path, recommend_by, category, recommend_reason, created_at, recommended_at)
                  VALUES (?,?,?,?,?,?,?,?,?,?,?,?)""",
        (sid, title, desc, day_no or None, None, media, attachment,
         session.get("display_name") or mentor_id, category, reason,
         datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
         datetime.now().strftime("%Y-%m-%d %H:%M:%S")))
    db.commit()
    flash("已推荐为标杆作品", "success")
    return redirect(url_for("mentor_student_detail", sid=sid))


