@app.route("/pm/excellent")
@login_required
@role_required("pm")
def pm_excellent():
    db = get_db()
    # 自动候选：S/A 级学员（取最新结业记录）
    cands = db.execute("""
        SELECT s.sid, s.name, s.school, s.major, c.grade, c.total_score, c.work_advice,
               (SELECT COUNT(*) FROM showcase_work sw WHERE sw.sid=s.sid) AS works_count
        FROM campus_student s
        JOIN campus_cert_result c ON c.sid=s.sid AND c.cert_id = (
            SELECT MAX(cert_id) FROM campus_cert_result c2 WHERE c2.sid=s.sid AND c2.is_valid=1)
        WHERE c.grade IN ('S','A') ORDER BY c.total_score DESC""").fetchall()
    # 助教提名待 PM 终审
    pending_noms = db.execute("""
        SELECT n.*, s.name AS stu_name FROM excellent_nomination n
        LEFT JOIN campus_student s ON n.sid=s.sid
        WHERE n.status='nominated' ORDER BY n.id DESC""").fetchall()
    confirmed_noms = db.execute("""
        SELECT n.*, s.name AS stu_name FROM excellent_nomination n
        LEFT JOIN campus_student s ON n.sid=s.sid
        WHERE n.status IN ('confirmed','rejected') ORDER BY n.id DESC LIMIT 30""").fetchall()
    return render_template("pm_excellent.html", candidates=cands,
                           pending_noms=pending_noms, confirmed_noms=confirmed_noms,
                           user={"display_name":session.get("display_name"),"role":"pm"},
                           active="pm_excellent")


@app.route("/pm/excellent/confirm", methods=["POST"])
@login_required
@role_required("pm")
def pm_excellent_confirm():
    db = get_db()
    nom_id = int(request.form.get("nom_id", "0"))
    action = request.form.get("action", "")
    nom = db.execute("SELECT * FROM excellent_nomination WHERE id=?", (nom_id,)).fetchone()
    if not nom:
        flash("提名不存在", "error")
        return redirect(url_for("pm_excellent"))
    if action == "confirm":
        db.execute("UPDATE excellent_nomination SET status='confirmed' WHERE id=?", (nom_id,))
        # 联动校友会：升级为骨干校友
        db.execute("UPDATE alumni SET alumni_level='骨干校友' WHERE sid=?", (nom["sid"],))
        _audit(db, "优秀学员确认", f"确认 {nom['sid']} 为「{nom['round_name']}」优秀学员", nom["sid"])
        flash(f"已确认 {nom['sid']} 入选优秀学员，并升级为骨干校友", "success")
    elif action == "reject":
        db.execute("UPDATE excellent_nomination SET status='rejected' WHERE id=?", (nom_id,))
        flash(f"已驳回 {nom['sid']} 的提名", "info")
    db.commit()
    return redirect(url_for("pm_excellent"))


