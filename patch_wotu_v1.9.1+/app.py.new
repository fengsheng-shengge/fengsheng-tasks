                           user=user, active="expert_appeal")


@app.route("/expert/appeal/<int:appeal_id>", methods=["GET", "POST"])
@login_required
@role_required("expert")
def expert_appeal_handle(appeal_id):
    """专家处理学员申诉：查看原成绩与申诉理由，接受重审/驳回"""
    db = get_db()
    appeal = db.execute("SELECT * FROM campus_appeal WHERE appeal_id=?", (appeal_id,)).fetchone()
    if not appeal:
        flash("申诉不存在", "error")
        return redirect(url_for("expert_dashboard"))
    if request.method == "POST":
        action = request.form.get("action", "")
        comment = request.form.get("handle_comment", "").strip()
        if action == "reject":
            db.execute("""UPDATE campus_appeal SET deal_status='rejected', deal_operator=?,
                          appeal_reason=appeal_reason||char(10)||'【处理意见】'||? WHERE appeal_id=?""",
                (session["user_id"], comment or "经复核维持原判定", appeal_id))
            _audit(db, "申诉处理", f"驳回申诉 #{appeal_id}：{comment[:30]}", appeal["sid"])
            flash("已驳回该申诉（维持原判定）", "info")
        elif action == "accept":
            db.execute("""UPDATE campus_appeal SET deal_status='resolved', deal_operator=?,
                          appeal_reason=appeal_reason||char(10)||'【处理意见】'||? WHERE appeal_id=?""",
                (session["user_id"], comment or "接受申诉，已重新核定", appeal_id))
            _audit(db, "申诉处理", f"接受申诉并复核 #{appeal_id}：{comment[:30]}", appeal["sid"])
            flash("已接受申诉并标记为复核完成（可在成绩页调整该学员成绩后重发证书）", "success")
        db.commit()
        return redirect(url_for("expert_dashboard"))
    # 原成绩详情
    origin = db.execute("SELECT * FROM campus_cert_result WHERE cert_id=?", (appeal["origin_cert_result_id"],)).fetchone()
    stu = db.execute("SELECT * FROM campus_student WHERE sid=?", (appeal["sid"],)).fetchone()
    user = {"display_name": session.get("display_name"), "role": "expert"}
    return render_template("expert_appeal.html", appeal=appeal, origin=origin, stu=stu,
                           user=user, active="expert_appeal")


# ─── 学员：上岗技能清单（结业后自我盘点）───
@app.route("/my-skills", methods=["GET", "POST"])
@login_required
@role_required("student")
def student_skills():
    sid = sid_for_user(session["user_id"]) or session["user_id"]
    db = get_db()
    if request.method == "POST":
        mastered = request.form.getlist("mastered")  # 勾选的skill_id列表
        # 更新勾选项为已掌握，其余为需补强
        for row in db.execute("SELECT id FROM onboard_skill WHERE sid=?", (sid,)).fetchall():
            db.execute("UPDATE onboard_skill SET mastered=?, updated_at=? WHERE id=?",
                       (1 if str(row["id"]) in mastered else 0,
                        datetime.now().strftime("%Y-%m-%d %H:%M:%S"), row["id"]))
        db.commit()
        flash("技能清单已保存，请与带教师傅逐项核对", "success")
        return redirect(url_for("student_skills"))
    skills = db.execute("SELECT * FROM onboard_skill WHERE sid=? ORDER BY skill_tag, id", (sid,)).fetchall()
    if not skills:
        # 首次进入：从7天任务初始化
        for tdef in TASK_DEFS:
            for sk in tdef["skills"]:
                db.execute("INSERT OR IGNORE INTO onboard_skill (sid, skill_tag, skill_name, mastered, source) VALUES (?,?,?,0,'task')",
                           (sid, tdef["module"].split("·")[0].strip()[:10], sk))
        db.commit()
        skills = db.execute("SELECT * FROM onboard_skill WHERE sid=? ORDER BY skill_tag, id", (sid,)).fetchall()
    mastered_count = sum(1 for s in skills if s["mastered"])
    user = {"display_name": session.get("display_name"), "role": "student", "sid": sid}
    return render_template("student_skills.html", skills=skills,
                           mastered_count=mastered_count, total=len(skills),
                           user=user, active="skills")


# ─── 学员：上岗陪跑进度（1-3个月跟踪）───
@app.route("/my-followup")
@login_required
@role_required("student")
def student_followup():
    sid = sid_for_user(session["user_id"]) or session["user_id"]
    db = get_db()
    stu = db.execute("SELECT * FROM campus_student WHERE sid=?", (sid,)).fetchone()
    mentor = db.execute("SELECT * FROM mentorship WHERE sid=?", (sid,)).fetchone()
    followups = db.execute("SELECT * FROM monthly_followup WHERE sid=? ORDER BY month_no", (sid,)).fetchall()
    cert = db.execute("SELECT * FROM campus_cert_result WHERE sid=? AND is_valid=1 ORDER BY cert_id DESC LIMIT 1",
                     (sid,)).fetchone()
    # 技能掌握率
    sk = db.execute("SELECT COUNT(*) c, SUM(mastered) m FROM onboard_skill WHERE sid=?", (sid,)).fetchone()
    mastery = round((sk["m"] or 0) / sk["c"] * 100) if sk["c"] else 0
    user = {"display_name": session.get("display_name"), "role": "student", "sid": sid}
    return render_template("student_followup.html", stu=stu, mentor=mentor,
                           followups=followups, cert=cert or {}, mastery=mastery,
                           user=user, active="followup")


@app.route("/my-followup/self", methods=["POST"])
@login_required
@role_required("student")
def student_followup_self():
    """学员月度自评：先自评，导师/班主任评分后可对比"""
    sid = sid_for_user(session["user_id"]) or session["user_id"]
    db = get_db()
    month_no = int(request.form.get("month_no", "1"))
    self_score = int(request.form.get("self_score", "0"))
    self_comment = request.form.get("self_comment", "").strip()
    progress = request.form.get("progress", "").strip()
    db.execute("""INSERT INTO monthly_followup (sid, month_no, self_score, self_comment, status, created_at)
                  VALUES (?,?,?,?,?,?)
                  ON CONFLICT(sid, month_no) DO UPDATE SET
                    self_score=excluded.self_score,
                    self_comment=excluded.self_comment""",
        (sid, month_no, self_score,
         (self_comment + ("\n【进展】" + progress if progress else "")),
         "pending", datetime.now().strftime("%Y-%m-%d %H:%M:%S")))
    db.commit()
    _audit(db, "学员自评", f"第{month_no}个月自评 {self_score} 分", sid)
    flash(f"第{month_no}个月自评已提交", "success")
    return redirect(url_for("student_followup"))


