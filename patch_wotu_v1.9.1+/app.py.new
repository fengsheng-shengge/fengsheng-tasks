# ─── 批量导入学员（CSV）公共逻辑 ───
def import_students_csv(db, content, default_class_id):
    """解析 CSV 并批量创建学员+账号，返回 (ok_count, skip_count, errors)"""
    import io as _io
    reader = csv.DictReader(_io.StringIO(content))
    ok, skip, errors = 0, 0, []
    now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    for i, row in enumerate(reader, start=2):
        sid = (row.get("sid") or "").strip()
        name = (row.get("name") or "").strip()
        if not sid or not name:
            errors.append(f"第{i}行：sid/姓名不能为空")
            continue
        cls = (row.get("class_id") or "").strip() or default_class_id
        try:
            exists = db.execute("SELECT sid FROM campus_student WHERE sid=?", (sid,)).fetchone()
            if exists:
                db.execute("""UPDATE campus_student SET name=?, school=?, major=?, gender=?, phone=?, wechat=?, class_id=?, updated_at=? WHERE sid=?""",
                    (name, (row.get("school") or "").strip(), (row.get("major") or "").strip(),
                     (row.get("gender") or "").strip(), (row.get("phone") or "").strip(),
                     (row.get("wechat") or "").strip(), cls, now, sid))
                skip += 1
            else:
                db.execute("""INSERT INTO campus_student (sid, name, class_id, student_status, school, major, phone, wechat, gender, enroll_date, created_at, updated_at)
                              VALUES (?,?,?,?,?,?,?,?,?,?,?,?)""",
                    (sid, name, cls, "在训", (row.get("school") or "").strip(), (row.get("major") or "").strip(),
                     (row.get("phone") or "").strip(), (row.get("wechat") or "").strip(),
                     (row.get("gender") or "").strip(), now[:10], now, now))
                # 建登录账号（密码默认 123456）
                acc = db.execute("SELECT user_id FROM campus_user_role WHERE user_id=?", (sid,)).fetchone()
                if not acc:
                    db.execute("""INSERT INTO campus_user_role (user_id, role, managed_class_ids, display_name, created_at, password_hash)
                                  VALUES (?,?,?,?,?,?)""",
                        (sid, "student", cls, name, now, hash_pwd("123456")))
                ok += 1
        except Exception as e:
            errors.append(f"第{i}行：{e}")
    db.commit()
    return ok, skip, errors


# ─── 班主任：学员成绩明细（只读）+ 批量导入/导出 ───
@app.route("/teacher/students")
@login_required
@role_required("teacher")
def teacher_students():
    db = get_db()
    managed = session.get("managed_class_ids", "class01")
    class_ids = [c.strip() for c in managed.split(",") if c.strip()]
    rows = db.execute("""
        SELECT s.*, c.total_score, c.grade, c.is_pass, c.cert_no, c.work_advice,
               m.mentor_name, m.store_name,
               (SELECT COUNT(*) FROM practice_submission ps WHERE ps.sid=s.sid) AS sub_count
        FROM campus_student s
        LEFT JOIN campus_cert_result c ON c.sid=s.sid AND c.cert_id = (SELECT MAX(cert_id) FROM campus_cert_result c2 WHERE c2.sid=s.sid AND c2.is_valid=1)
        LEFT JOIN mentorship m ON s.sid=m.sid
        WHERE s.class_id IN (%s) ORDER BY s.sid""" % ",".join("?"*len(class_ids)), class_ids).fetchall()
    return render_template("teacher_students.html", students=rows,
                           user={"display_name":session.get("display_name"),"role":"teacher"},
                           active="teacher_students", class_ids=",".join(class_ids))


@app.route("/teacher/students/export")
@login_required
@role_required("teacher")
def teacher_students_export():
    db = get_db()
    managed = session.get("managed_class_ids", "class01")
    class_ids = [c.strip() for c in managed.split(",") if c.strip()]
    rows = db.execute("""
        SELECT s.sid, s.name, s.school, s.major, s.gender, s.phone, s.student_status,
               c.grade, c.is_pass, c.cert_no, c.total_score, c.work_advice,
               m.mentor_name, m.store_name
        FROM campus_student s
        LEFT JOIN campus_cert_result c ON c.sid=s.sid AND c.cert_id = (SELECT MAX(cert_id) FROM campus_cert_result c2 WHERE c2.sid=s.sid AND c2.is_valid=1)
        LEFT JOIN mentorship m ON s.sid=m.sid
        WHERE s.class_id IN (%s) ORDER BY s.sid""" % ",".join("?"*len(class_ids)), class_ids).fetchall()
    buf = io.StringIO()
    w = csv.writer(buf)
    w.writerow(["学号","姓名","学校","专业","性别","手机号","状态","定级","是否通过","证书号","综合分","上岗建议","师傅","门店"])
    for r in rows:
        w.writerow([r["sid"], r["name"], r["school"] or "", r["major"] or "", r["gender"] or "",
                    r["phone"] or "", r["student_status"] or "", r["grade"] or "",
                    "通过" if r["is_pass"] else ("未通过" if r["is_pass"]==0 else ""),
                    r["cert_no"] or "", r["total_score"] or "", r["work_advice"] or "",
                    r["mentor_name"] or "", r["store_name"] or ""])
    resp = Response(buf.getvalue().encode("utf-8-sig"), mimetype="text/csv")
    resp.headers["Content-Disposition"] = "attachment; filename=students.csv"
    return resp


@app.route("/teacher/students/import", methods=["POST"])
@login_required
@role_required("teacher")
def teacher_students_import():
    f = request.files.get("file")
    if not f or not f.filename:
        flash("请选择 CSV 文件", "danger")
        return redirect(url_for("teacher_students"))
    content = f.read().decode("utf-8-sig", errors="replace")
    managed = session.get("managed_class_ids", "class01")
    default_cls = managed.split(",")[0].strip()
    ok, skip, errors = import_students_csv(get_db(), content, default_cls)
    msg = f"导入完成：新增 {ok} 人，跳过重复 {skip} 人" + (f"，{len(errors)} 行有误" if errors else "")
    flash(msg, "success" if ok else "warn")
    if errors:
        flash("；".join(errors[:5]), "danger")
    return redirect(url_for("teacher_students"))


