                    task_done=excluded.task_done, avg_score=excluded.avg_score, status='nominated', created_by=excluded.created_by""",
        (sid, round_name, reason, p["total"], done, avg, "nominated",
         session.get("display_name") or "助教", datetime.now().strftime("%Y-%m-%d %H:%M:%S")))
