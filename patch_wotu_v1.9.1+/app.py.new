@app.route("/coach/supervise")
@login_required
@role_required("coach")
def coach_supervise():
    """督导工作台：全班进度总览 + 预警 + 督导记录"""
    db = get_db()
    students = db.execute("SELECT sid, name FROM campus_student ORDER BY sid").fetchall()
    subs = db.execute("""
        SELECT ps.sid, ps.day, ps.deliverable_index, pr.score, pr.reviewed_at
        FROM practice_submission ps LEFT JOIN practice_review pr ON ps.id=pr.submission_id""").fetchall()
    logs = db.execute("SELECT * FROM supervision_log ORDER BY id DESC LIMIT 50").fetchall()
    log_map = {}
    for l in logs:
        log_map.setdefault((l["sid"], l["day_no"] or 0), []).append(l)
    total_nodes = len([d for t in TASK_DEFS for d in t["deliverables"]])
    rows = []
    pending_sub, pending_rev, low_score = 0, 0, 0
    for stu in students:
        done_nodes = set()
        pending_nodes = set()
        low_nodes = []
        for s in subs:
            if s["sid"] != stu["sid"]:
                continue
            key = (s["day"], s["deliverable_index"] or 0)
            if s["reviewed_at"]:
                done_nodes.add(key)
                if (s["score"] or 0) < 60:
                    low_nodes.append(key)
            else:
                pending_nodes.add(key)
        sub_days = len({(s["day"]) for s in subs if s["sid"] == stu["sid"]})
        done_count = len(done_nodes)
        pending_count = len(pending_nodes)
        pending_sub += pending_count
        low_score += len(low_nodes)
        rate = round(done_count / total_nodes * 100, 1)
        # 预警等级
        warn = ""
        if pending_count > 0:
            warn = "🟡 有未审核"
            pending_rev += 0
        if sub_days == 0:
            warn = "🔴 未开始"
        elif done_count == 0 and pending_count > 0:
            warn = "🟠 只交未审"
        elif rate < 60:
            warn = "🔴 进度落后"
        elif low_nodes:
            warn = "🟠 低分需辅导"
        elif rate == 100:
            warn = "🟢 全部完成"
        logs_for_stu = log_map.get((stu["sid"], 0), [])
        rows.append({"sid": stu["sid"], "name": stu["name"], "sub_days": sub_days,
                     "done": done_count, "pending": pending_count,
                     "total": total_nodes, "rate": rate, "warn": warn, "logs": logs_for_stu})
    rows.sort(key=lambda r: r["rate"])
    user = {"display_name": session.get("display_name"), "role": "coach"}
    return render_template("coach_supervise.html", rows=rows, logs=logs, warn_stats={
        "pending": pending_sub, "low": low_score, "n": len(students)},
        user=user, active="coach_supervise",
        day_titles={i+1: TASK_DEFS[i]["title"] for i in range(7)})


