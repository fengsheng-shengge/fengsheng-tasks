@app.route("/coach/points/settle", methods=["POST"])
@login_required
@role_required("coach")
def coach_points_settle():
    """按规则自动结算积分（幂等：同一 sid+day+action 不重复加分；分值从 system_config 读取）"""
    db = get_db()
    now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    coach = session.get("display_name") or "助教"
    P_SUBMIT = _get_config_int(db, "points_submit", 3)
    P_DRILL = _get_config_int(db, "points_drill", 5)
    P_85 = _get_config_int(db, "points_review85", 10)
    P_60 = _get_config_int(db, "points_review60", 5)
    P_FULL = _get_config_int(db, "points_attendance", 20)
    students = db.execute("SELECT sid FROM campus_student").fetchall()
    subs = db.execute("""
        SELECT ps.sid, ps.day, ps.deliverable_index, pr.score, pr.reviewed_at,
               (SELECT COUNT(*) FROM practice_review pr2 WHERE pr2.submission_id=ps.id) AS reviewed
        FROM practice_submission ps
        LEFT JOIN practice_review pr ON pr.submission_id=ps.id""").fetchall()
    total_nodes = len([d for t in TASK_DEFS for d in t["deliverables"]])
    added = 0

    def _grant(sid, day_no, action, points, reason):
        nonlocal added
        exists = db.execute("""SELECT id FROM points_record WHERE sid=? AND day_no=? AND action_type=?""",
                            (sid, day_no, action)).fetchone()
        if not exists:
            db.execute("""INSERT INTO points_record (sid, day_no, action_type, points, reason, created_by, created_at)
                          VALUES (?,?,?,?,?,?,?)""", (sid, day_no, action, points, reason, coach, now))
            added += 1

    for stu in students:
        sid = stu["sid"]
        stu_subs = [s for s in subs if s["sid"] == sid]
        done_days = set()
        all_submitted = len(stu_subs) >= total_nodes
        for s in stu_subs:
            # 按天：有提交 +P_SUBMIT
            _grant(sid, s["day"], "submit", P_SUBMIT, f"Day{s['day']} 提交实操交付节点")
            done_days.add(s["day"])
            # 演练节点额外 +P_DRILL
            if s["deliverable_index"] is not None and s["deliverable_index"] == 3:
                _grant(sid, s["day"], "drill", P_DRILL, f"Day{s['day']} 完成演练节点")
            # 审核评分
            if s["reviewed"]:
                score = s["score"] or 0
                if score >= 85:
                    _grant(sid, s["day"], "review85", P_85, f"Day{s['day']} 实操评分 {score} 分（优秀）")
                elif score >= 60:
                    _grant(sid, s["day"], "review60", P_60, f"Day{s['day']} 实操评分 {score} 分（合格）")
        if all_submitted:
            _grant(sid, 0, "attendance", P_FULL, "7天实操全勤完成")
    db.commit()
    _audit(db, "积分结算", f"自动结算积分，新增 {added} 条记录")
    flash(f"积分结算完成：新增 {added} 条积分记录", "success")
    return redirect(url_for("coach_points"))


@app.route("/coach/excellent")
@login_required
@role_required("coach")
def coach_excellent():
    """优秀评选：候选排名 + 推荐"""
    db = get_db()
    students = db.execute("SELECT sid, name FROM campus_student ORDER BY sid").fetchall()
    # 每个学员的积分/任务完成数/均分
    cands = []
    for s in students:
        p = _points_summary(db, s["sid"])
        stu_subs = db.execute("""SELECT ps.day, pr.score FROM practice_submission ps
                                 LEFT JOIN practice_review pr ON ps.id=pr.submission_id
                                 WHERE ps.sid=?""", (s["sid"],)).fetchall()
        reviewed = [x for x in stu_subs if x["score"] is not None]
        avg = round(sum(x["score"] for x in reviewed) / len(reviewed), 1) if reviewed else 0
        done = len({x["day"] for x in stu_subs})
        cands.append({"sid": s["sid"], "name": s["name"], "points": p["total"],
                      "task_done": done, "task_total": 7, "avg": avg})
    cands.sort(key=lambda r: (r["points"], r["avg"]), reverse=True)
    for i, c in enumerate(cands):
        c["rank"] = i + 1
    nominations = db.execute("SELECT * FROM excellent_nomination ORDER BY id DESC LIMIT 50").fetchall()
    nom_map = {(n["sid"], n["round_name"]): n for n in nominations}
    user = {"display_name": session.get("display_name"), "role": "coach"}
    return render_template("coach_excellent.html", cands=cands, nominations=nominations,
                           nom_map=nom_map, user=user, active="coach_excellent",
                           day_titles={i+1: TASK_DEFS[i]["title"] for i in range(7)})


