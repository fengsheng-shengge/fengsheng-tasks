@app.route("/my-appeal", methods=["POST"])
@login_required
@role_required("student")
def student_appeal_submit():
    """学员对结业结果提交申诉（进入专家处理队列）"""
    sid = sid_for_user(session["user_id"]) or session["user_id"]
    db = get_db()
    cert = db.execute("SELECT * FROM campus_cert_result WHERE sid=? AND is_valid=1 ORDER BY cert_id DESC LIMIT 1",
                     (sid,)).fetchone()
    reason = request.form.get("appeal_reason", "").strip()
    if not reason:
        flash("请填写申诉理由", "error")
        return redirect(url_for("student_cert"))
    if cert is None:
        flash("暂无有效的结业成绩可申诉", "error")
        return redirect(url_for("student_cert"))
    # 同一证书只允许一条待处理申诉
    exist = db.execute(
        "SELECT * FROM campus_appeal WHERE sid=? AND origin_cert_result_id=? AND deal_status='pending'",
        (sid, cert["cert_id"])).fetchone()
    if exist:
        flash("该成绩已有一条待处理申诉，请等待处理结果", "error")
        return redirect(url_for("student_cert"))
    db.execute("""INSERT INTO campus_appeal (sid, origin_cert_result_id, appeal_reason, submit_time,
                  deal_status, window_hours, created_at)
                  VALUES (?,?,?,?,?,?,?)""",
        (sid, cert["cert_id"], reason, datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
         "pending", 48, datetime.now().strftime("%Y-%m-%d %H:%M:%S")))
    db.commit()
    _audit(db, "成绩申诉", f"对结业结果提交申诉：{reason[:30]}", sid)
    flash("申诉已提交，专家将在 48 小时内处理，可在本页查看进度", "success")
    return redirect(url_for("student_cert"))


