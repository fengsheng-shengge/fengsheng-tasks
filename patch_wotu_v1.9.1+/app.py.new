# ─── 世赛三条：P2 软实力主观分（四标尺双角色）───
@app.route("/soft_review/<sid>", methods=["GET", "POST"])
@login_required
@role_required("coach", "expert")
def soft_review(sid):
    db = get_db()
    if request.method == "POST":
        empathy = int(request.form.get("empathy", 0))
        adapt = int(request.form.get("adapt", 0))
        express = int(request.form.get("express", 0))
        service = int(request.form.get("service", 0))
        practical_score = int(request.form.get("practical_score", 0))
        practical_comment = request.form.get("practical_comment", "")
        scenario_score = int(request.form.get("scenario_score", 0))
        scenario_comment = request.form.get("scenario_comment", "")
        overall = request.form.get("comment", "")
        work_advice = request.form.get("work_advice", "")
        reviewer = session.get("display_name")
        role = session.get("role")
        db.execute("""INSERT INTO soft_review_score
            (sid, empathy_score, adapt_score, express_score, service_score, reviewer, reviewer_role, comment, created_at)
            VALUES (?,?,?,?,?,?,?,?,?)""",
            (sid, empathy, adapt, express, service, reviewer, role, overall,
             datetime.now().strftime("%Y-%m-%d %H:%M:%S")))
        db.execute("""INSERT INTO expert_review
            (sid, practical_score, practical_comment, scenario_score, scenario_comment,
             empathy_score, adapt_score, express_score, service_score, overall_comment, reviewer, created_at)
            VALUES (?,?,?,?,?,?,?,?,?,?,?,?)""",
            (sid, practical_score, practical_comment, scenario_score, scenario_comment,
             empathy, adapt, express, service, overall, reviewer,
             datetime.now().strftime("%Y-%m-%d %H:%M:%S")))
        # 上岗建议写入证书（转化衔接）
        if work_advice:
            db.execute("UPDATE campus_cert_result SET work_advice=? WHERE sid=? AND is_valid=1",
                       (work_advice, sid))
        db.commit()
        flash("综合评审已提交", "success")
        return redirect(url_for("expert_dashboard"))

    history = db.execute(
        "SELECT * FROM soft_review_score WHERE sid=? ORDER BY created_at DESC", (sid,)).fetchall()
    student = db.execute("SELECT * FROM campus_student WHERE sid=?", (sid,)).fetchone()
    # 学员综合实操提交（day=8）
    practical = db.execute("SELECT * FROM practice_submission WHERE sid=? AND day=8", (sid,)).fetchone()
    # 学员日常实操提交+助教审核
    daily_subs = db.execute("""
        SELECT ps.*, pr.score as coach_score, pr.comment as coach_comment, pr.reviewer,
               pr.drill_speak, pr.drill_content, pr.drill_logic
        FROM practice_submission ps
        LEFT JOIN practice_review pr ON ps.id = pr.submission_id
        WHERE ps.sid=? AND ps.day<8 ORDER BY ps.day, ps.deliverable_index
    """, (sid,)).fetchall()
    # 理论考试成绩
    theory = db.execute("SELECT * FROM campus_quiz_result WHERE sid=? ORDER BY rowid DESC LIMIT 1", (sid,)).fetchone()
    # 最新证书
    cert = db.execute("SELECT * FROM campus_cert_result WHERE sid=? AND is_valid=1 ORDER BY cert_id DESC LIMIT 1", (sid,)).fetchone()
    user = {"display_name": session.get("display_name"), "role": session.get("role")}
    return render_template("soft_review.html", sid=sid, history=history,
                           student=student, user=user, active="expert_dashboard",
                           practical=practical, daily_subs=daily_subs,
                           theory=theory, cert=cert)


# ─── 班主任工作台 ───
@app.route("/dashboard/teacher")
@login_required
@role_required("teacher")
def teacher_dashboard():
    db = get_db()
    # 班主任管的班级
    managed = session.get("managed_class_ids", "class01")
    class_ids = [c.strip() for c in managed.split(",") if c.strip()]
    # 学员列表
    stu_rows = db.execute(
        "SELECT s.*, c.total_score, c.grade, c.is_pass FROM campus_student s "
        "LEFT JOIN campus_cert_result c ON c.sid=s.sid AND c.cert_id = (SELECT MAX(cert_id) FROM campus_cert_result c2 WHERE c2.sid=s.sid AND c2.is_valid=1) "
        "WHERE s.class_id IN (%s) ORDER BY s.sid" % ",".join("?"*len(class_ids)),
        class_ids).fetchall()
    # 每个学员每天完成情况
    students = []
    for s in stu_rows:
        d = dict(s)
        day_status = []
        for day in range(1, 8):
            total_deliv = len(TASK_DEFS[day-1]["deliverables"])
            submitted = db.execute(
                "SELECT COUNT(DISTINCT deliverable_index) c FROM practice_submission WHERE sid=? AND day=?",
                (s["sid"], day)).fetchone()["c"]
            qr = db.execute(
                "SELECT score FROM campus_quiz_result WHERE sid=? AND quiz_group=?",
                (s["sid"], TASK_DEFS[day-1]["paper"])).fetchone()
            day_status.append({
                "day": day,
                "title": TASK_DEFS[day-1]["title"],
                "deliv_done": submitted,
                "deliv_total": total_deliv,
                "quiz_done": bool(qr),
                "done": submitted >= total_deliv and bool(qr),
            })
        d["days"] = day_status
        d["done_days"] = sum(1 for x in day_status if x["done"])
        students.append(d)
    # 待结对提醒（已结业未结对）
    unpaired = db.execute("""
        SELECT s.sid, s.name, s.student_status FROM campus_student s
        WHERE s.class_id IN (%s) AND s.sid IN (SELECT sid FROM campus_cert_result WHERE is_pass=1 AND is_valid=1)
        AND s.sid NOT IN (SELECT sid FROM mentorship WHERE status='active')
        ORDER BY s.sid""" % ",".join("?"*len(class_ids)), class_ids).fetchall()
    user = {"display_name": session.get("display_name"), "role": "teacher"}
    banner = {
        "title": "沃土计划 · 预备经纪人实训营",
        "vision": "班主任是实训营的操盘手：管进度、抓质量、保转化，让每个学员都按时走到结业与上岗。",
        "expect_title": "致班主任 · 班级的进度与温度，都在你手上",
        "expect_desc": "你负责班级全流程运营：跟踪 7 天实训进度、审核实操评分、组织月度陪跑评估，并把优秀的学员推向结业与上岗。用批量导入省下机械操作，把时间留给真正需要关注的学员。",
        "theme": "blue",
        "features": [
            {"icon": "📊", "name": "班级总览", "desc": "进度·通过·预警", "url": url_for("teacher_dashboard")},
            {"icon": "🗂", "name": "学员档案", "desc": "明细·画像·证书", "url": url_for("teacher_students")},
            {"icon": "🚀", "name": "陪跑管理", "desc": "月度评估·店长复核", "url": url_for("teacher_followup", sid="S001")},
            {"icon": "📥", "name": "批量导入", "desc": "CSV 一键建班", "url": url_for("teacher_students_import")},
            {"icon": "📤", "name": "导出表格", "desc": "成绩/进度导出", "url": url_for("teacher_students_export")},
        ],
    }
    return render_template("teacher_dashboard.html", students=students,
                           user=user, active="teacher_dashboard",
                           unpaired_count=len(unpaired),
                           banner=banner)


# ─── PM：学员档案管理 ───
@app.route("/pm/students")
@login_required
@role_required("pm")
def pm_students():
    db = get_db()
    q = request.args.get("q", "").strip()
    status = request.args.get("status", "")
    sql = "SELECT s.*, c.total_score, c.grade, c.is_pass, c.cert_no, c.is_valid, c.will_risk_flag FROM campus_student s LEFT JOIN campus_cert_result c ON c.sid=s.sid AND c.cert_id = (SELECT MAX(cert_id) FROM campus_cert_result c2 WHERE c2.sid=s.sid AND c2.is_valid=1) WHERE 1=1"
    params = []
    if q:
        sql += " AND (s.sid LIKE ? OR s.name LIKE ?)"
        params += [f"%{q}%", f"%{q}%"]
    if status == "passed":
        sql += " AND c.is_pass=1"
    elif status == "failed":
        sql += " AND c.is_pass=0"
    elif status == "risk":
        sql += " AND (c.will_risk_flag=1 OR s.sid IN (SELECT DISTINCT sid FROM campus_risk_action))"
    sql += " ORDER BY s.sid"
    rows = db.execute(sql, params).fetchall()
    students = []
    for r in rows:
        d = dict(r)
        d["has_risk"] = bool(d["will_risk_flag"])
        students.append(d)
    user = {"display_name": session.get("display_name"), "role": "pm"}
    return render_template("pm_students.html", students=students, q=q, status=status,
                           user=user, active="pm_students")


@app.route("/pm/student/<sid>")
@login_required
@role_required("pm")
def pm_student_detail(sid):
    db = get_db()
    student = db.execute("SELECT * FROM campus_student WHERE sid=?", (sid,)).fetchone()
    if not student:
        flash("学员不存在", "danger")
        return redirect(url_for("pm_students"))
    cert = db.execute("SELECT * FROM campus_cert_result WHERE sid=? AND is_valid=1 ORDER BY cert_id DESC LIMIT 1", (sid,)).fetchone()
    submissions = db.execute("SELECT * FROM practice_submission WHERE sid=? ORDER BY day", (sid,)).fetchall()
    reviews = db.execute("SELECT r.*, p.day FROM practice_review r JOIN practice_submission p ON r.submission_id=p.id WHERE r.sid=? ORDER BY p.day", (sid,)).fetchall()
    soft_scores = db.execute("SELECT * FROM soft_review_score WHERE sid=? ORDER BY created_at DESC", (sid,)).fetchall()
    risks = db.execute("SELECT * FROM campus_risk_action WHERE sid=? ORDER BY rowid DESC", (sid,)).fetchall()
    evidences = db.execute("SELECT * FROM phase_evidence WHERE student_sid=? ORDER BY created_at DESC LIMIT 20", (sid,)).fetchall()
    mentor = db.execute("SELECT * FROM mentorship WHERE sid=?", (sid,)).fetchone()
    followups = db.execute("SELECT * FROM monthly_followup WHERE sid=? ORDER BY month_no", (sid,)).fetchall()
    # 实操能力综合分（参考维度，不参与定级）：实操三维均分60% + 情景应变25% + 测验15%
    def _num(x):
        try:
            return float(x)
        except (TypeError, ValueError):
            return None
    drill_scores = [v for v in ([_num(r["drill_speak"]) for r in reviews] +
                   [_num(r["drill_content"]) for r in reviews] +
                   [_num(r["drill_logic"]) for r in reviews]) if v is not None]
    drill_avg = round(sum(drill_scores)/len(drill_scores), 1) if drill_scores else None
    scen_scores = [v for v in [_num(r[0]) for r in db.execute(
        "SELECT score_step FROM phase_evidence WHERE student_sid=? AND score_step IS NOT NULL", (sid,)).fetchall()] if v is not None]
    scen_avg = round(sum(scen_scores)/len(scen_scores), 1) if scen_scores else None
    quiz_scores = [v for v in [_num(r[0]) for r in db.execute(
        "SELECT score FROM campus_quiz_result WHERE sid=?", (sid,)).fetchall()] if v is not None]
    quiz_avg = round(sum(quiz_scores)/len(quiz_scores), 1) if quiz_scores else None
    comp_score = None
    if drill_avg is not None:
        comp_score = round(drill_avg*0.6 + (scen_avg or quiz_avg or 0)*0.25 + (quiz_avg or 0)*0.15, 1)
    user = {"display_name": session.get("display_name"), "role": "pm"}
    return render_template("pm_student_detail.html", student=student, cert=cert,
                           submissions=submissions, reviews=reviews, soft_scores=soft_scores,
                           risks=risks, evidences=evidences, user=user, active="pm_students",
                           mentor=mentor, followups=followups, drill_avg=drill_avg,
                           scen_avg=scen_avg, quiz_avg=quiz_avg, comp_score=comp_score,
                           day_titles={i+1: TASK_DEFS[i]["title"] for i in range(7)})


# ─── PM：上岗跟踪总览（结业转化看板）───
@app.route("/pm/onboard")
@login_required
@role_required("pm")
def pm_onboard():
    db = get_db()
    # 结业学员 + 结对/陪跑状态
    rows = db.execute("""
        SELECT s.sid, s.name, s.school, s.student_status,
               c.grade, c.is_pass, c.cert_no,
               m.mentor_name, m.store_name, m.start_date AS pair_date,
               (SELECT COUNT(*) FROM monthly_followup f WHERE f.sid=s.sid AND f.status='done') AS done_months,
               (SELECT COUNT(*) FROM onboard_skill sk WHERE sk.sid=s.sid) AS skill_total,
               (SELECT COUNT(*) FROM onboard_skill sk WHERE sk.sid=s.sid AND sk.mastered=1) AS skill_mastered
        FROM campus_student s
        LEFT JOIN campus_cert_result c ON c.sid=s.sid AND c.cert_id = (SELECT MAX(cert_id) FROM campus_cert_result c2 WHERE c2.sid=s.sid AND c2.is_valid=1)
        LEFT JOIN mentorship m ON s.sid=m.sid
        WHERE c.is_pass=1
        ORDER BY s.sid""").fetchall()
    stats = {
        "passed": len(rows),
        "paired": sum(1 for r in rows if r["mentor_name"]),
        "unpaired": sum(1 for r in rows if not r["mentor_name"]),
        "m1_done": sum(1 for r in rows if r["done_months"] >= 1),
        "m3_done": sum(1 for r in rows if r["done_months"] >= 3),
    }
    user = {"display_name": session.get("display_name"), "role": "pm"}
    return render_template("pm_onboard.html", rows=rows, stats=stats,
                           user=user, active="pm_onboard")


# ─── PM：结业认证管理 ───
@app.route("/pm/cert")
@login_required
@role_required("pm")
def pm_cert():
    db = get_db()
    rows = latest_certs(db)
    name_map = {r["sid"]: r["name"] for r in db.execute("SELECT sid, name FROM campus_student").fetchall()}
    risk_sids = {r["sid"] for r in db.execute("SELECT DISTINCT sid FROM campus_risk_action").fetchall()}
    certs = []
    for r in rows:
        d = dict(r)
        d["name"] = name_map.get(r["sid"], "—")
        d["has_risk"] = r["sid"] in risk_sids
        certs.append(d)
    pending = [c for c in certs if not c.get("cert_no")]
    issued = [c for c in certs if c.get("cert_no")]
    user = {"display_name": session.get("display_name"), "role": "pm"}
    return render_template("pm_cert.html", certs=certs, pending=pending, issued=issued,
                           user=user, active="pm_cert")


@app.route("/pm/cert/action", methods=["POST"])
@login_required
@role_required("pm")
def pm_cert_action():
    db = get_db()
    sid = request.form.get("sid")
    action = request.form.get("action")  # pass / reject
    if not sid:
        flash("参数错误", "danger")
        return redirect(url_for("pm_cert"))
    cert = db.execute("SELECT * FROM campus_cert_result WHERE sid=? AND is_valid=1 ORDER BY cert_id DESC LIMIT 1", (sid,)).fetchone()
    if not cert:
        flash("该学员暂无成绩", "danger")
        return redirect(url_for("pm_cert"))
    cert_id = cert["cert_id"]
    if action == "pass":
        cert_no = f"WOTU-2026-{sid}-{cert_id:03d}"
        db.execute("UPDATE campus_cert_result SET is_pass=1, cert_no=?, reject_msg=NULL WHERE cert_id=?", (cert_no, cert_id))
        flash(f"已通过认证，证书号：{cert_no}", "success")
    elif action == "reject":
        reason = request.form.get("reject_msg", "未达标")
        db.execute("UPDATE campus_cert_result SET is_pass=0, reject_msg=? WHERE cert_id=?", (reason, cert_id))
        flash(f"已驳回：{reason}", "warn")
    db.commit()
    return redirect(url_for("pm_cert"))


# ─── 学员：学 · 课程学习 ───
@app.route("/study")
@login_required
@role_required("student", "teacher", "pm")
def student_study():
    sid = sid_for_user(session["user_id"]) or session["user_id"]
    db = get_db()
    # 学习行为打卡：同一学员同一天只记一条"学习打卡"（防刷）
    today = datetime.now().strftime("%Y-%m-%d")
    hit = db.execute("SELECT 1 FROM study_activity WHERE sid=? AND act_type='study_checkin' AND created_at LIKE ?",
                     (sid, today + "%")).fetchone()
    if not hit:
        db.execute("INSERT INTO study_activity (sid, act_type, detail, created_at) VALUES (?,?,?,?)",
                   (sid, "study_checkin", "进入课程学习页", datetime.now().strftime("%Y-%m-%d %H:%M:%S")))
        db.commit()
    days = []
    for tdef in TASK_DEFS:
        qr = db.execute("SELECT score FROM campus_quiz_result WHERE sid=? AND quiz_group=?",
                        (sid, tdef["paper"])).fetchone()
        days.append({
            "day": tdef["day"], "title": tdef["title"], "module": tdef["module"],
            "study": tdef["study"], "skills": tdef["skills"],
            "done": bool(qr), "score": qr["score"] if qr else None,
        })
    materials = db.execute("SELECT * FROM course_material ORDER BY day, created_at DESC").fetchall()
    user = {"display_name": session.get("display_name"), "role": session.get("role")}
    return render_template("student_study.html", days=days, user=user, active="study", materials=materials)


