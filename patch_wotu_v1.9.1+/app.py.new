        return redirect(url_for("coach_excellent"))
    p = _points_summary(db, sid)
    stu_subs = db.execute("""SELECT ps.day, pr.score FROM practice_submission ps
                             LEFT JOIN practice_review pr ON ps.id=pr.submission_id
                             WHERE ps.sid=?""", (sid,)).fetchall()
    reviewed = [x for x in stu_subs if x["score"] is not None]
    avg = round(sum(x["score"] for x in reviewed) / len(reviewed), 1) if reviewed else 0
    done = len({x["day"] for x in stu_subs})
